---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
	{ label: 'Trámites y servicios', href: '#tramites-y-servicios' },
	{ label: 'Campañas', href: '#campanas' },
	{ label: 'Canales de atención y redes sociales', href: '#contacto' },
	{ label: 'Noticias', href: '#noticias' },
	{ label: 'Información institucional', href: '#informacion-institucional' },
	{ label: 'Informes y publicaciones', href: '#informes' },
	{ label: 'Enlaces de interés', href: '#enlaces-de-interes' },
];
---

<header class="bg-white border-b border-slate-200 text-slate-800 dark:bg-slate-900 dark:border-slate-800 dark:text-slate-100">
	<div class="container-sunat flex flex-wrap items-center justify-between gap-x-6 gap-y-4 py-3">
		<a
			href="/"
			class="flex items-center gap-3 rounded-md focus-visible:outline-[#0877a7]"
			aria-label="gob.pe y SUNAT, ir al inicio"
		>
			<img
				src="/img/escudo_blanco.1b27b421.svg"
				alt=""
				width="92"
				height="32"
				class="h-8 w-auto filter invert dark:invert-0"
			/>
			<img
				src="/img/gobpe_blanco.b8dd3ffa.svg"
				alt="gob.pe"
				width="82"
				height="20"
				class="hidden h-5 w-auto sm:block filter invert dark:invert-0"
			/>
			<span class="hidden h-8 w-px bg-slate-300 dark:bg-slate-700 md:block"></span>
			<span class="hidden flex-col text-[11px] leading-tight text-slate-600 dark:text-slate-300 md:flex">
				Plataforma digital única
				<br />del Estado Peruano
			</span>
			<span class="hidden text-lg font-black tracking-tight text-[#075782] dark:text-sky-400 lg:block">SUNAT</span>
		</a>

		<!-- CONTROLES MÓVILES -->
		<div class="ml-auto flex items-center gap-2 lg:hidden">
			<div class="flex h-10 items-center justify-center rounded-xl bg-[#0877a7] px-3 text-white [&_*]:text-white! [&_*]:stroke-white!">
				<ThemeToggle compact />
			</div>
			<button
				type="button"
				class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-slate-300 text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
				aria-expanded="false"
				aria-controls="menu-movil"
				aria-label="Abrir menú"
				data-menu-toggle
			>
				<Icon name="menu" size={22} />
			</button>
		</div>

		<!-- SECCIÓN DERECHA: BOTÓN MODO TEMA + INICIAR SESIÓN CON ÍCONO LOG-IN -->
		<div class="hidden lg:flex items-center gap-3 ml-auto">
			<div class="btn-theme-custom inline-flex h-11 items-center justify-center rounded-xl bg-[#0877a7] px-4 text-sm font-bold text-white shadow-sm transition hover:bg-[#075782]">
				<ThemeToggle />
			</div>

			<div class="flex items-center gap-3">
				<a
					href="/login"
					class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-[#0877a7] px-5 text-sm font-bold text-white shadow-sm transition hover:bg-[#075782] focus-visible:outline-[#0877a7]"
				>
					<Icon name="log-in" size={18} />
					Iniciar sesión
				</a>

				<p class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-600 dark:text-slate-300">
					<span class="h-2 w-2 rounded-full bg-amber-500" aria-hidden="true"></span>
					<span>Sin sesión iniciada</span>
				</p>
			</div>
		</div>
	</div>
</header>

<!-- MENÚ PRINCIPAL NAVEGACIÓN CON FONDO AZUL DE LA PORTADA (#075782) -->
<nav
	aria-label="Menú principal"
	class="sticky top-0 z-40 hidden bg-[#075782] text-white shadow-md lg:block"
>
	<div class="container-sunat">
		<ul class="flex items-stretch justify-between">
			{
				navItems.map((item, index) => (
					<li class="flex-1">
						<a
							href={item.href}
							data-nav-link
							aria-current={index === 0 ? 'location' : undefined}
							class="flex h-full items-center justify-center border-b-4 border-transparent px-2 py-3.5 text-center text-[13px] font-bold text-white/90 transition hover:bg-[#0877a7] hover:text-white aria-[current=location]:border-sky-400 aria-[current=location]:bg-[#0877a7] aria-[current=location]:text-white"
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</nav>

<!-- MENÚ DESPLEGABLE MÓVIL EN AZUL PORTADA -->
<nav
	id="menu-movil"
	aria-label="Menú principal móvil"
	class="bg-[#075782] text-white lg:hidden"
	hidden
>
	<ul class="container-sunat grid gap-1 py-3">
		{
			navItems.map((item, index) => (
				<li>
					<a
						href={item.href}
						data-nav-link
						aria-current={index === 0 ? 'location' : undefined}
						class="flex items-center justify-between rounded-lg px-3 py-3 text-sm font-bold text-white transition hover:bg-[#0877a7]"
					>
						{item.label}
						<Icon name="chevron-right" size={16} />
					</a>
				</li>
			))
		}
	</ul>
</nav>

<aside aria-label="Estado de la sesión" class="border-b border-amber-200 bg-amber-50 dark:border-amber-900 dark:bg-amber-950/40">
	<div class="container-sunat flex flex-col gap-3 py-3 sm:flex-row sm:items-center sm:justify-between">
		<p class="flex items-start gap-2 text-sm text-amber-950 dark:text-amber-100">
			<Icon name="info" size={18} class="mt-0.5 shrink-0 text-amber-700 dark:text-amber-300" />
			<span>
				<strong class="font-bold">No has iniciado sesión.</strong>
				Puedes explorar trámites y servicios. Entra con tu Clave SOL para ver tus datos
				personales.
			</span>
		</p>
		<a
			href="/login"
			class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-amber-900 px-4 py-2 text-sm font-bold text-white transition hover:bg-amber-950 focus-visible:outline-amber-900 dark:bg-amber-900 dark:text-amber-50 dark:hover:bg-amber-800"
		>
			Iniciar sesión
			<Icon name="arrow-right" size={16} />
		</a>
	</div>
</aside>

<aside
	aria-label="Comunicaciones destacadas"
	class="fixed bottom-4 right-4 z-50 max-w-[calc(100vw-2rem)] md:bottom-6 md:right-6"
>
	<a
		href="https://www.sunat.gob.pe/mensajes/mensajes-SUNAT.html"
		target="_blank"
		rel="noopener noreferrer"
		class="group flex flex-col items-end gap-2"
	>
		<span
			class="relative rounded-xl border border-slate-200 bg-white px-3 py-2 text-right text-xs font-semibold text-slate-800 shadow-lg after:absolute after:right-5 after:top-full after:h-0 after:w-0 after:border-4 after:border-transparent after:border-t-white dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:after:border-t-slate-900"
		>
			Comunicaciones destacadas, <span class="text-[#0877a7] dark:text-sky-300">ver más</span>
		</span>
		<span
			class="relative grid h-14 w-14 place-items-center rounded-full bg-[#0877a7] text-white shadow-xl transition-colors animate-hop group-hover:bg-[#075782] motion-reduce:animate-none"
		>
			<Icon name="newspaper" size={26} />
			<span
				class="absolute -right-0.5 -top-0.5 h-3.5 w-3.5 rounded-full border-2 border-white bg-amber-400 dark:border-slate-900"
				aria-hidden="true"></span>
		</span>
	</a>
</aside>

<style is:global>
	.btn-theme-custom button,
	.btn-theme-custom span,
	.btn-theme-custom svg,
	.btn-theme-custom p {
		color: #ffffff !important;
		fill: currentColor !important;
		border-color: transparent !important;
		background-color: transparent !important;
	}
</style>

<script src="../scripts/header.js"></script>