---
import Icon from './Icon.astro';

const quickLinks = [
	{
		label: 'Centro de Servicios Virtual',
		icon: '/img/i-csv.png',
		description: 'Haz trámites y consultas por internet, sin ir a una oficina.',
	},
	{
		label: 'Sorteo Virtual',
		icon: '/img/isorteovirtual.png',
		description: 'Revisa si tu boleta de venta salió premiada.',
	},
	{
		label: 'Consulta RUC',
		icon: '/img/rucOf.jpg',
		description: 'Mira tu número de RUC, el que te identifica ante SUNAT, y revisa tus datos.',
	},
	{
		label: 'Renta Anual 2025',
		icon: '/img/iRenta2025.jpg',
		description: 'Declara tus ingresos y gastos del año 2025 para calcular tu impuesto.',
	},
	{
		label: 'Libro de reclamaciones',
		icon: '/img/libro-de-reclamaciones.224b5083.svg',
		description: 'Deja una queja o reclamo sobre la atención o un servicio.',
	},
	{
		label: 'Capacitación para microempresas',
		icon: '/img/icapacita.png',
		description: 'Aprende con cursos y guías a manejar mejor tu negocio.',
	},
	{
		label: 'Buzón electrónico SOL',
		icon: '/img/buzon.b97c948b.svg',
		description: 'Revisa los mensajes y avisos que SUNAT te envía por internet.',
	},
	{
		label: 'Paga aquí tu Fraccionamiento',
		icon: '/img/fracc02.png',
		description: 'Paga en cuotas la deuda que acordaste con SUNAT.',
	},
	{
		label: 'Denuncia actos de corrupción',
		icon: '/img/idenu.jpg',
		description: 'Reporta de forma segura un caso de corrupción.',
	},
	{
		label: 'Mesa de partes',
		icon: '/img/mesa-de-partes.e8d187ca.svg',
		description: 'Presenta documentos o solicitudes para que SUNAT los revise.',
	},
];
---

<!-- BLOQUE PRINCIPAL CON FONDO BLANCO PARA ELIMINAR EL CORTE DE COLOR -->
<div class="bg-white dark:bg-slate-950">
	<!-- BANNER AZUL (#075782) -->
	<section class="hero-grid relative overflow-hidden bg-[#075782] text-white">
		<div class="absolute -right-20 -top-40 h-96 w-96 rounded-full border-[70px] border-white/5 pointer-events-none"></div>
		<div class="absolute bottom-0 right-[25%] h-56 w-56 rounded-full bg-cyan-400/10 blur-3xl pointer-events-none"></div>

		<div class="relative container-sunat grid gap-10 py-12 lg:grid-cols-[1.2fr_0.8fr] lg:py-20">
			<!-- Textos y Acciones principales -->
			<div class="max-w-2xl">
				<div class="mb-5 inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.12em] text-cyan-100 ring-1 ring-white/15">
					<Icon name="shield-check" size={16} /> SERVICIOS DIGITALES
				</div>
				
				<h1 class="text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
					Tus trámites tributarios, más simples y cerca de ti.
				</h1>
				
				<p class="mt-6 max-w-xl text-lg leading-8 text-sky-100">
					Realiza operaciones, consulta tu información y encuentra orientación para cumplir con tus obligaciones.
				</p>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href="/login" class="flex items-center gap-2 rounded-xl bg-white px-6 py-3.5 text-sm font-bold text-[#075782] shadow-xl transition hover:-translate-y-0.5">
						Ingresar a Clave SOL
						<Icon name="arrow-right" size={18} />
					</a>
					<a href="#tramites-y-servicios" class="rounded-xl border border-white/30 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-white/10">
						Ver trámites frecuentes
					</a>
				</div>
			</div>

			<!-- Ilustración gráfica Figma -->
			<div class="hidden items-center justify-center lg:flex">
				<div class="relative h-72 w-72">
					<div class="absolute inset-0 rotate-6 rounded-[48px] bg-white/10 ring-1 ring-white/20"></div>
					<div class="absolute inset-5 -rotate-3 rounded-[38px] bg-gradient-to-br from-white to-sky-100 p-8 shadow-2xl">
						<div class="flex items-center justify-between">
							<div class="h-3 w-24 rounded-full bg-sky-200"></div>
							<div class="grid h-10 w-10 place-items-center rounded-full bg-emerald-100 text-emerald-600">
								<Icon name="check" size={20} />
							</div>
						</div>
						<div class="mt-8 h-4 w-36 rounded-full bg-slate-200"></div>
						<div class="mt-3 h-3 w-44 rounded-full bg-slate-100"></div>
						<div class="mt-8 grid grid-cols-3 gap-3">
							<div class="h-16 rounded-xl bg-[#0877a7]"></div>
							<div class="h-16 rounded-xl bg-cyan-100"></div>
							<div class="h-16 rounded-xl bg-slate-100"></div>
						</div>
						<div class="mt-5 h-10 rounded-xl bg-slate-100"></div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- BUSCADOR FLOTANTE CON FONDO BLANCO CONTINUO -->
	<section class="relative z-10 container-sunat -mt-7 pb-6">
		<form id="form-buscador-portada" class="flex flex-col gap-3 rounded-2xl bg-white p-4 shadow-xl shadow-slate-900/5 sm:flex-row sm:items-center dark:bg-slate-900 dark:border dark:border-slate-800">
			<div class="flex min-w-fit items-center gap-3 px-2 text-sm font-bold text-slate-700 dark:text-slate-200">
				<Icon name="search" size={18} />
				<span>¿Qué trámite necesitas?</span>
			</div>
			
			<div class="relative flex-1">
				<input
					type="text"
					id="buscador-portada"
					aria-label="Buscar trámites"
					class="w-full rounded-xl bg-slate-100 px-4 py-3 text-sm text-slate-900 outline-none ring-[#0877a7] placeholder:text-slate-400 focus:ring-2 dark:bg-slate-800 dark:text-white dark:placeholder:text-slate-500"
					placeholder="Ej. emitir recibo por honorarios"
					autocomplete="off"
				/>
				<div id="resultados-busqueda-portada" class="hidden absolute top-full left-0 right-0 mt-2 rounded-2xl border border-slate-200 bg-white p-3 shadow-2xl dark:border-slate-800 dark:bg-slate-900 z-50 text-slate-900 dark:text-white space-y-1"></div>
			</div>

			<button type="submit" class="rounded-xl bg-[#0877a7] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#075782]">
				Buscar
			</button>
		</form>
	</section>
</div>

<!-- SECCIÓN ORIGINAL DE ACCESOS RÁPIDOS EN BLANCO CONTINUO -->
<section class="border-b border-slate-100 bg-white dark:border-slate-800 dark:bg-slate-950">
	<div class="container-sunat py-10 lg:py-14">
		<div>
			<div class="max-w-3xl">
				<img
					src="/img/sunat-logo.svg"
					alt="SUNAT"
					width="149"
					height="32"
					class="h-9 w-auto"
				/>
				<h2 class="mt-5 text-balance text-3xl font-bold leading-tight text-slate-900 dark:text-white md:text-4xl">
					Superintendencia Nacional de Aduanas y de Administración Tributaria
				</h2>
				<p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300 md:text-lg">
					Nos encargamos de los impuestos y de revisar lo que entra y sale del país. Aquí
					encuentras tus trámites, pagos y consultas en un solo lugar.
				</p>
				<a
					href="https://www.gob.pe/4107-superintendencia-nacional-de-aduanas-y-de-administracion-tributaria-que-hacemos"
					target="_blank"
					rel="noopener noreferrer"
					class="mt-4 inline-flex items-center gap-2 font-bold text-sunat-blue hover:underline dark:text-sky-400 dark:hover:text-sky-300"
				>
					Conocer más
					<Icon name="arrow-right" size={18} />
				</a>
			</div>

			<h3 class="mt-10 text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
				Accesos rápidos
			</h3>
			<p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
				Cada tarjeta te explica en palabras simples para qué sirve.
				<span class="hidden lg:inline">Pasa el cursor sobre una tarjeta para ver la explicación.</span>
			</p>
			<ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-5">
				{
					quickLinks.map((link) => (
						<li>
							<a
								href="#tramites-y-servicios"
								class="quick-card group relative flex h-full min-h-36 flex-col overflow-hidden rounded-xl border border-slate-200 bg-white p-4 text-sm font-semibold leading-snug text-slate-700 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-sunat-blue/50 hover:shadow-lg focus-visible:outline-offset-2 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:hover:border-sky-500/60 dark:hover:shadow-slate-950/60 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
							>
								<span class="grid h-11 w-11 shrink-0 place-items-center overflow-hidden rounded-lg bg-slate-50 transition group-hover:scale-105 dark:bg-slate-100 motion-reduce:transition-none">
									<img src={link.icon} alt="" class="h-7 w-7 object-contain" loading="lazy" />
								</span>
								<span class="mt-3">{link.label}</span>
								<span class="quick-card-help" aria-hidden="true">
									<span class="quick-card-help-title">{link.label}</span>
									<span class="quick-card-help-text">{link.description}</span>
								</span>
								<span class="sr-only">{link.description}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.quick-card-help {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-top: 0.5rem;
		font-size: 0.75rem;
		font-weight: 400;
		line-height: 1.5;
		color: #475569;
	}

	.quick-card-help-title {
		display: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.quick-card {
			min-height: 9.5rem;
		}

		.quick-card-help {
			position: absolute;
			inset: 0;
			justify-content: center;
			margin-top: 0;
			padding: 1rem;
			background: linear-gradient(145deg, #0056ac, #003f7e);
			color: #eff6ff;
			opacity: 0;
			transform: translateY(0.75rem);
			transition:
				opacity 0.2s ease,
				transform 0.2s ease;
			pointer-events: none;
		}

		.quick-card-help-title {
			display: block;
			color: #fff;
			font-size: 0.8125rem;
			font-weight: 700;
			line-height: 1.25;
		}

		.quick-card:hover .quick-card-help,
		.quick-card:focus-visible .quick-card-help {
			opacity: 1;
			transform: translateY(0);
			color: #eff6ff;
		}
	}

	@media (hover: none), (max-width: 767px) {
		.quick-card-help {
			position: static;
			margin-top: 0.5rem;
			padding: 0;
			background: none;
			color: #475569;
			opacity: 1;
			transform: none;
			transition: none;
			pointer-events: auto;
		}

		.quick-card-help-title {
			display: none;
		}
	}

	:global(.dark) .quick-card-help {
		color: #94a3b8;
	}

	@media (prefers-reduced-motion: reduce) {
		.quick-card-help {
			transition: none;
		}
	}
</style>

<script src="../scripts/portada.js"></script>