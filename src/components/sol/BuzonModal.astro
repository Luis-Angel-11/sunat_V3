---
import Icon from '../Icon.astro';
---

<div
	id="buzon-modal"
	class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm transition-opacity duration-200"
	role="dialog"
	aria-modal="true"
	aria-labelledby="buzon-modal-title"
>
	<div class="relative w-full max-w-lg rounded-3xl bg-white p-6 shadow-2xl transition-all dark:border dark:border-slate-800 dark:bg-slate-900 sm:p-8">
		
		<!-- CABECERA -->
		<div class="flex items-center justify-between border-b border-slate-100 pb-4 dark:border-slate-800">
			<div class="flex items-center gap-3">
				<div class="grid h-10 w-10 place-items-center rounded-xl bg-sky-50 text-[#0877a7] dark:bg-sky-950 dark:text-sky-300">
					<Icon name="inbox" size={22} />
				</div>
				<div>
					<h2 id="buzon-modal-title" class="text-xl font-extrabold text-slate-900 dark:text-white">
						Buzón electrónico
					</h2>
					<p class="text-[11px] font-medium text-slate-400">Haz clic en un mensaje para leer su contenido</p>
				</div>
			</div>

			<button
				type="button"
				id="close-buzon-modal"
				class="grid h-9 w-9 place-items-center rounded-xl text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200"
				aria-label="Cerrar ventana"
			>
				<Icon name="x" size={20} />
			</button>
		</div>

		<!-- CONTENEDOR DE MENSAJES (SE RENDERIZAN Y MANEJAN POR JS) -->
		<div id="lista-mensajes-buzon" class="mt-5 space-y-3 max-h-[60vh] overflow-y-auto pr-1"></div>

	</div>
</div>

<script src="../../scripts/buzonModal.js"></script>