---
import Icon from '../Icon.astro';

/**
 * Encabezado de un campo con botón de ayuda (?) que despliega una explicación sencilla.
 * - `para`: id del control (usa <label for>). Si se omite, se usa `etiquetaId` y se renderiza un <p>
 *   para que un grupo de opciones (role="radiogroup") lo use con aria-labelledby.
 */
interface Props {
	id: string;
	etiqueta: string;
	para?: string;
	etiquetaId?: string;
	requerido?: boolean;
	opcional?: boolean;
}

const { id, etiqueta, para, etiquetaId, requerido = false, opcional = false } = Astro.props;
const panelId = `ayuda-${id}`;
---

<div class="flex items-start justify-between gap-2">
	{
		para ? (
			<label for={para} class="sol-label mb-0 pt-1.5">
				{etiqueta}
				{requerido && <span class="text-red-600 dark:text-rose-400"> *</span>}
				{opcional && <span class="font-normal text-slate-500 dark:text-slate-400"> (opcional)</span>}
			</label>
		) : (
			<p id={etiquetaId} class="sol-label mb-0 pt-1.5">
				{etiqueta}
				{requerido && <span class="text-red-600 dark:text-rose-400"> *</span>}
				{opcional && <span class="font-normal text-slate-500 dark:text-slate-400"> (opcional)</span>}
			</p>
		)
	}
	<button
		type="button"
		data-ayuda
		aria-expanded="false"
		aria-controls={panelId}
		aria-label={`Ayuda sobre «${etiqueta}»`}
		title="¿Qué es esto?"
		class="ayuda-btn inline-flex h-8 shrink-0 items-center gap-1 rounded-full px-2 text-xs font-bold text-sunat-blue transition hover:bg-sky-50 dark:text-sky-300 dark:hover:bg-slate-800"
	>
		<Icon name="help-circle" size={17} />
		<span class="hidden sm:inline">Ayuda</span>
	</button>
</div>
<div id={panelId} hidden class="ayuda-panel mb-2 mt-1.5 rounded-xl border border-sky-200 bg-sky-50 p-3 text-sm leading-relaxed text-slate-700 dark:border-sky-900 dark:bg-sky-950/40 dark:text-slate-200">
	<slot />
</div>
