---
import Icon from '../Icon.astro';
import type { IconName } from '../../data/icons';

interface Props {
	activeMenu?: 'panel' | 'consultar' | 'emitir' | 'declarar' | 'tramites' | 'ayuda';
}

const { activeMenu = 'panel' } = Astro.props;

const menuItems: {
	id: string;
	label: string;
	href: string;
	icon: IconName;
	subItems?: { label: string; href: string }[];
}[] = [
	{
		id: 'panel',
		label: 'Mi Panel SOL',
		href: '/prueba',
		icon: 'home',
	},
	{
		id: 'consultar',
		label: 'Consultar',
		href: '/sol/consultar',
		icon: 'search',
		subItems: [
			{ label: 'Consulta de Facturas,boleta', href: '/facturas/consulta' },
			{ label: 'Consulta de Validez de CPE', href: '/validez-comprobante/consultar' },
		],
	},
	{
		id: 'emitir',
		label: 'Emitir',
		href: '/sol/emitir',
		icon: 'file-text',
		subItems: [
			{ label: 'Guía de Remisión (GRE)', href: '/guias/emitir' },
			{ label: 'Factura Electrónica', href: '/facturas/emitir' },
			{ label: 'Recibo por Honorarios (RHE)', href: '/recibos/emitir' },
		],
	},
	{
		id: 'declarar',
		label: 'Declarar y Pagar',
		href: '/sol/declarar',
		icon: 'credit-card',
		subItems: [
			{ label: 'Declaración IGV - Renta', href: '/declara/igv-renta-621' },
			{ label: 'Pago de tributos pendientes', href: '/declara/pago-tributos' },
			{ label: 'Historial de pagos', href: '/declara/historial-pagos' },
		],
	},
	{
		id: 'tramites',
		label: 'Trámites y Reclamos',
		href: '/sol/tramites',
		icon: 'shield-check',
		subItems: [
			{ label: 'Libro de Reclamaciones', href: '/libro-reclamaciones' },
			{ label: 'Ficha RUC y datos', href: '/perfil#datos' },
			{ label: 'Solicitud de Fraccionamiento', href: '/tramites/fraccionamiento' },
		],
	},
	{
		id: 'ayuda',
		label: 'Ayuda',
		href: '/sol/ayuda',
		icon: 'help-circle',
		subItems: [
			{ label: 'Cronograma de Vencimientos', href: '/ayuda/cronograma-vencimientos' },
			{ label: 'Guías explicativas', href: '/ayuda/guias' },
			{ label: 'Asistente Virtual Sofia', href: '/ayuda/sofia' },
		],
	},
];
---

<!-- BOTÓN FLOTANTE DE MENÚ PARA MÓVILES (VISIBLE SOLO EN PANTALLAS PEQUEÑAS) -->
<button
	type="button"
	id="btn-abrir-sidebar-movil"
	aria-label="Abrir menú de operaciones"
	class="md:hidden fixed bottom-5 left-5 z-40 inline-flex items-center gap-2 rounded-full bg-[#003366] px-4 py-3 text-xs font-extrabold text-white shadow-xl border border-white/15 active:scale-95 transition"
>
	<Icon name="menu" size={18} />
	<span>Menú SOL</span>
</button>

<!-- FONDO OSCURO (BACKDROP) EN MÓVIL -->
<div
	id="sidebar-backdrop-movil"
	class="md:hidden fixed inset-0 z-40 hidden bg-slate-950/60 backdrop-blur-xs transition-opacity"
></div>

<!-- SIDEBAR RESPONSIVO (CAJÓN EN MÓVIL / FIJO EN ESCRITORIO) -->
<aside
	id="sol-sidebar-panel"
	class="fixed inset-y-0 left-0 z-50 w-64 shrink-0 -translate-x-full border-r border-slate-200 bg-white transition-transform duration-200 ease-out dark:border-slate-800 dark:bg-slate-900 md:static md:translate-x-0 md:min-h-[calc(100vh-104px)] select-none overflow-y-auto"
>
	<div class="p-4">
		<div class="flex items-center justify-between">
			<span class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400 dark:text-slate-500">
				MIS OPERACIONES
			</span>
			<button
				type="button"
				id="btn-cerrar-sidebar-movil"
				aria-label="Cerrar menú"
				class="md:hidden rounded-lg p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800"
			>
				<Icon name="x" size={18} />
			</button>
		</div>

		<nav class="mt-3 space-y-1" aria-label="Menú lateral de operaciones">
			{
				menuItems.map((item) => {
					const isActive = item.id === activeMenu;
					const hasSub = Boolean(item.subItems && item.subItems.length > 0);

					if (!hasSub) {
						return (
							<a
								href={item.href}
								class={`flex items-center gap-3 rounded-xl px-3.5 py-3 text-xs font-bold transition ${
									isActive
										? 'bg-[#003366] text-white shadow-md'
										: 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800'
								}`}
							>
								<Icon name={item.icon} size={18} class={isActive ? 'text-white' : 'text-slate-500 dark:text-slate-400'} />
								<span>{item.label}</span>
							</a>
						);
					}

					return (
						<div class="sidebar-accordion group">
							<button
								type="button"
								class={`flex w-full items-center justify-between rounded-xl px-3.5 py-3 text-xs font-bold transition text-left ${
									isActive
										? 'bg-[#003366] text-white shadow-md'
										: 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800'
								}`}
							>
								<div class="flex items-center gap-3">
									<Icon name={item.icon} size={18} class={isActive ? 'text-white' : 'text-slate-500 dark:text-slate-400'} />
									<span>{item.label}</span>
								</div>
								<span class={`chevron-icon transition-transform duration-200 ${isActive ? 'rotate-90' : ''}`}>
									<Icon name="chevron-right" size={14} class={isActive ? 'text-white/80' : 'text-slate-400'} />
								</span>
							</button>

							<!-- SUBMENÚ CON OPCIONES SECUNDARIAS -->
							<div class={`submenu-container ${isActive ? '' : 'hidden'} pl-9 pr-2 py-1 space-y-1`}>
								{item.subItems?.map((sub) => (
									<a
										href={sub.href}
										class="block rounded-lg px-2.5 py-1.5 text-[11px] font-semibold text-slate-600 hover:bg-slate-100 hover:text-[#0877a7] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-sky-300 transition"
									>
										→ {sub.label}
									</a>
								))}
							</div>
						</div>
					);
				})
			}
		</nav>
	</div>
</aside>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const toggles = document.querySelectorAll('.sidebar-accordion button');
		const sidebar = document.getElementById('sol-sidebar-panel');
		const backdrop = document.getElementById('sidebar-backdrop-movil');
		const btnAbrir = document.getElementById('btn-abrir-sidebar-movil');
		const btnCerrar = document.getElementById('btn-cerrar-sidebar-movil');

		const abrirSidebarMovil = () => {
			sidebar?.classList.remove('-translate-x-full');
			backdrop?.classList.remove('hidden');
		};

		const cerrarSidebarMovil = () => {
			sidebar?.classList.add('-translate-x-full');
			backdrop?.classList.add('hidden');
		};

		btnAbrir?.addEventListener('click', abrirSidebarMovil);
		btnCerrar?.addEventListener('click', cerrarSidebarMovil);
		backdrop?.addEventListener('click', cerrarSidebarMovil);

		toggles.forEach((button) => {
			button.addEventListener('click', () => {
				const container = button.nextElementSibling;
				const chevron = button.querySelector('.chevron-icon');

				if (container) {
					const isHidden = container.classList.contains('hidden');

					document.querySelectorAll('.submenu-container').forEach((el) => el.classList.add('hidden'));
					document.querySelectorAll('.chevron-icon').forEach((el) => el.classList.remove('rotate-90'));

					if (isHidden) {
						container.classList.remove('hidden');
						chevron?.classList.add('rotate-90');
					}
				}
			});
		});
	});
</script>