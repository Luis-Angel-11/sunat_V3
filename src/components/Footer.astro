---
import Icon from './Icon.astro';

const socialLinks = [
	{ name: 'Facebook', icon: 'facebook', href: 'https://www.facebook.com/SUNAT' },
	{ name: 'X (Twitter)', icon: 'twitter', href: 'https://twitter.com/SUNATOficial' },
	{ name: 'Instagram', icon: 'instagram', href: 'https://www.instagram.com/sunatoficial/' },
	{ name: 'LinkedIn', icon: 'linkedin', href: 'https://www.linkedin.com/company/sunat' },
	{ name: 'YouTube', icon: 'youtube', href: 'https://www.youtube.com/user/sunatvideos1' },
] as const;
---

<footer class="bg-slate-900 text-slate-300 dark:bg-slate-950">
	<div class="container-sunat grid gap-10 py-12 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
		<div>
			<a href="/" class="inline-flex rounded-lg bg-white p-3" aria-label="SUNAT, ir al inicio">
				<img src="/img/sunat-logo.svg" alt="SUNAT" width="149" height="32" class="h-8 w-auto" />
			</a>
			<p class="mt-4 max-w-md text-sm leading-relaxed text-slate-400">
				Nos encargamos de los impuestos y de revisar lo que entra y sale del país.
			</p>

			<div class="mt-5 space-y-2 text-sm">
				<a href="tel:+5113150730" class="flex items-center gap-2 hover:text-white">
					<Icon name="phone" size={16} class="text-slate-500" />
					Central de consultas: (01) 315 0730
				</a>
				<a href="tel:080112100" class="flex items-center gap-2 hover:text-white">
					<Icon name="phone" size={16} class="text-slate-500" />
					A nivel nacional: 0 801 12 100
				</a>
				<p class="flex items-start gap-2">
					<Icon name="map-pin" size={16} class="mt-0.5 shrink-0 text-slate-500" />
					Av. Garcilaso de la Vega 1472, Lima, Perú
				</p>
			</div>

			<div class="mt-6 flex flex-wrap gap-2">
				{
					socialLinks.map((social) => (
						<a
							href={social.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`${social.name} de la SUNAT`}
							class="grid h-10 w-10 place-items-center rounded-full bg-white/5 text-slate-300 transition hover:bg-white/10 hover:text-white"
						>
							<Icon name={social.icon} size={18} />
						</a>
					))
				}
			</div>
		</div>

		<nav aria-label="Sobre la SUNAT">
			<h2 class="text-sm font-bold uppercase tracking-wide text-white">Sobre la SUNAT</h2>
			<ul class="mt-4 space-y-3 text-sm">
				<li>
					<a href="#informacion-institucional" class="hover:text-white hover:underline"
						>Información institucional</a
					>
				</li>
				<li>
					<a href="#informacion-institucional" class="hover:text-white hover:underline"
						>Normas legales</a
					>
				</li>
				<li>
					<a href="#informes" class="hover:text-white hover:underline">Informes y publicaciones</a>
				</li>
				<li>
					<a href="#enlaces-de-interes" class="hover:text-white hover:underline"
						>Enlaces de interés</a
					>
				</li>
			</ul>
		</nav>

		<nav aria-label="Atención al ciudadano">
			<h2 class="text-sm font-bold uppercase tracking-wide text-white">Atención al ciudadano</h2>
			<ul class="mt-4 space-y-3 text-sm">
				<li>
					<a href="#contacto" class="hover:text-white hover:underline">Centros de servicios</a>
				</li>
				<li>
					<a href="#contacto" class="hover:text-white hover:underline">Central de consultas</a>
				</li>
				<li>
					<a
						href="https://www.sunat.gob.pe/institucional/contactenos/libroReclamaciones/comoPresentar-reclamo-queja-sugerencia.html"
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-white hover:underline">Libro de reclamaciones</a
					>
				</li>
				<li>
					<a href="#contacto" class="hover:text-white hover:underline">Chat SUNAT</a>
				</li>
			</ul>
		</nav>

		<nav aria-label="Accesos rápidos">
			<h2 class="text-sm font-bold uppercase tracking-wide text-white">Accesos rápidos</h2>
			<ul class="mt-4 space-y-3 text-sm">
				<li>
					<a href="#informacion-institucional" class="hover:text-white hover:underline"
						>Portal de transparencia</a
					>
				</li>
				<li>
					<a href="#tramites-y-servicios" class="hover:text-white hover:underline"
						>Mis trámites</a
					>
				</li>
				<li>
					<a href="/login" class="hover:text-white hover:underline">Iniciar sesión</a>
				</li>
				<li>
					<a href="#enlaces-de-interes" class="hover:text-white hover:underline"
						>Asistente Virtual Sofía</a
					>
				</li>
			</ul>

			<div class="mt-6 rounded-xl border border-white/10 bg-white/5 p-3">
				<p class="flex items-center gap-2 text-xs font-semibold text-amber-200">
					<span class="h-1.5 w-1.5 rounded-full bg-amber-300" aria-hidden="true"></span>
					Sin sesión iniciada
				</p>
				<a href="/login" class="mt-2 inline-flex items-center gap-1.5 text-xs font-bold text-white hover:underline">
					Entrar con mi Clave SOL
					<Icon name="arrow-right" size={13} />
				</a>
			</div>
		</nav>
	</div>

	<div class="border-t border-white/10 dark:border-slate-800">
		<div class="container-sunat flex flex-col gap-4 py-5 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between">
			<div class="flex items-center gap-3">
				<img src="/img/escudo_blanco.1b27b421.svg" alt="gob.pe" class="h-7 w-auto" />
				<img src="/img/gobpe_blanco.b8dd3ffa.svg" alt="gob.pe" class="h-4 w-auto" />
				<span>© 2026 SUNAT. Todos los derechos reservados.</span>
			</div>
			<div class="flex flex-wrap gap-4">
				<a href="#informacion-institucional" class="hover:text-white hover:underline"
					>Política de privacidad</a
				>
				<a href="#informacion-institucional" class="hover:text-white hover:underline"
					>Accesibilidad</a
				>
			</div>
		</div>
	</div>
</footer>
