---
import Icon from './Icon.astro';

const campaigns = [
	{
		title: 'Nuevo Centro de Servicios Virtual',
		image: '/img/campanas/2026/c-csv.png',
		tag: 'Nuevo',
		description: 'Haz trámites en línea desde un solo lugar.',
	},
	{
		title: 'Pide y Gana. ¡Tu boleta te premia!',
		image: '/img/campanas/2026/c-pideboleta.jpg',
		tag: 'Sorteo',
		description: 'Revisa si tu boleta participa y si ganaste un premio.',
	},
	{
		title: 'TU CLAVE SOL es personal: PROTÉGELA',
		image: '/img/campanas/2026/c-claveSol.png',
		tag: 'Seguridad',
		description: 'Tu clave es solo tuya. No la compartas con nadie.',
	},
];
---

<section id="campanas" class="scroll-mt-4 lg:scroll-mt-20 bg-white py-12 dark:bg-slate-950" aria-labelledby="titulo-campanas">
	<div class="container-sunat">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="text-sm font-bold uppercase tracking-wider text-sunat-magenta dark:text-rose-300">Campañas</p>
				<h2 id="titulo-campanas" class="mt-1 text-2xl font-bold text-slate-900 dark:text-white md:text-3xl">
					Información para estar al día
				</h2>
				<p class="mt-2 max-w-2xl text-slate-600 dark:text-slate-300">
					Novedades, sorteos y consejos para cuidar tu dinero y tu información.
				</p>
			</div>
			<a href="#campanas" class="link-sunat inline-flex items-center gap-2 text-sm">
				Ver todas las campañas
				<Icon name="arrow-right" size={15} />
			</a>
		</div>

		<ul class="mt-6 grid gap-5 md:grid-cols-3">
			{
				campaigns.map((campaign) => (
					<li>
						<article class="group h-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:shadow-slate-950/60">
							<a href="#campanas" class="block focus-visible:outline-offset-4">
								<div class="relative aspect-[16/9] overflow-hidden bg-slate-100 dark:bg-slate-800">
									<img
										src={campaign.image}
										alt=""
										loading="lazy"
										class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
									/>
									<span class="absolute left-3 top-3 rounded-full bg-white/95 px-3 py-1 text-xs font-bold text-sunat-magenta shadow-sm dark:bg-slate-900/95 dark:text-rose-300">
										{campaign.tag}
									</span>
								</div>
								<div class="p-5">
									<h3 class="text-base font-bold leading-snug text-slate-900 group-hover:text-sunat-blue dark:text-slate-100 dark:group-hover:text-sky-300">
										{campaign.title}
									</h3>
									<p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
										{campaign.description}
									</p>
									<span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-sunat-blue dark:text-sky-400">
										Leer más
										<Icon name="arrow-right" size={15} />
									</span>
								</div>
							</a>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>
