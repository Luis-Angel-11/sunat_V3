---
import Layout from '../../layouts/Layout.astro';
import SolHeader from '../../components/sol/SolHeader.astro';
import SolSidebar from '../../components/sol/SolSidebar.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../data/icons';

interface GuiaItem {
	id: string;
	titulo: string;
	categoria: 'Emitir' | 'Declarar y Pagar' | 'Trámites y Clave SOL' | 'Consultar';
	descripcion: string;
	duracion: string;
	ruta: string;
	icon: IconName;
	etiquetas: string;
}

const catalogoGuias: GuiaItem[] = [
	{
		id: 'guia-factura',
		titulo: 'Emisión de Factura Electrónica (SEE - SOL)',
		categoria: 'Emitir',
		descripcion: 'Aprende paso a paso cómo completar los datos del cliente, agregar productos o servicios, calcular el IGV y emitir facturas electrónicas.',
		duracion: 'Lectura 4 min · Video incluido',
		ruta: '/ayuda/factura',
		icon: 'receipt',
		etiquetas: 'factura electronica igv cliente ruc emitir comprobante',
	},
	{
		id: 'guia-remision',
		titulo: 'Emisión de Guía de Remisión Electrónica (GRE)',
		categoria: 'Emitir',
		descripcion: 'Guía detallada para registrar traslado de bienes, modalidad de transporte público o privado, datos del conductor y punto de llegada.',
		duracion: 'Lectura 5 min · Paso a paso',
		ruta: '/ayuda/guia-remision',
		icon: 'truck',
		etiquetas: 'guia remision traslado bienes transporte vehiculo remitente',
	},
	{
		id: 'guia-rhe',
		titulo: 'Emisión de Recibo por Honorarios Electrónico',
		categoria: 'Emitir',
		descripcion: 'Cómo emitir recibos por servicios independientes (4ta categoría), aplicar retención del 8% o presentar suspensión de retenciones.',
		duracion: 'Lectura 3 min',
		ruta: '/guias',
		icon: 'file-text',
		etiquetas: 'recibo honorarios cuarta categoria retencion 8% independiente',
	},
	{
		id: 'guia-igv-renta',
		titulo: 'Declaración Mensual IGV - Renta (Formulario 621)',
		categoria: 'Declarar y Pagar',
		descripcion: 'Instrucciones para determinar tus ventas y compras gravadas, aplicar saldo a favor del periodo anterior y presentar tu declaración.',
		duracion: 'Lectura 6 min · Caso práctico',
		ruta: '/declara/igv-renta-621',
		icon: 'calculator',
		etiquetas: 'declaracion mensual 621 igv renta mype tributario ventas compras',
	},
	{
		id: 'guia-pago-tributos',
		titulo: 'Pago de Tributos y Generación de NPS (Form. 1662)',
		categoria: 'Declarar y Pagar',
		descripcion: 'Cómo cancelar tributos pendientes mediante cargo en cuenta bancaria, tarjeta de débito/crédito o Número de Pago SUNAT.',
		duracion: 'Lectura 3 min',
		ruta: '/declara/pago-tributos',
		icon: 'credit-card',
		etiquetas: 'pago tributos boleta 1662 nps banco cargo cuenta',
	},
	{
		id: 'guia-fraccionamiento',
		titulo: 'Solicitud de Fraccionamiento Tributario (Form. 687)',
		categoria: 'Trámites y Clave SOL',
		descripcion: 'Requisitos, cálculo de cuota de acogimiento y pasos para fraccionar deudas exigibles hasta en 36 cuotas mensuales.',
		duracion: 'Lectura 5 min',
		ruta: '/tramites/fraccionamiento',
		icon: 'landmark',
		etiquetas: 'fraccionamiento deuda cuotas articulo 36 formulario 687',
	},
	{
		id: 'guia-clave-sol',
		titulo: 'Gestión de Clave SOL y Usuarios Secundarios',
		categoria: 'Trámites y Clave SOL',
		descripcion: 'Cómo actualizar tu contraseña SOL con seguridad, recuperar acceso y asignar perfiles a tu contador o personal.',
		duracion: 'Lectura 3 min',
		ruta: '/clave-sol',
		icon: 'key',
		etiquetas: 'clave sol contraseña seguridad usuario secundario perfil',
	},
	{
		id: 'guia-reclamaciones',
		titulo: 'Registro en el Libro de Reclamaciones Virtual',
		categoria: 'Trámites y Clave SOL',
		descripcion: 'Procedimiento para registrar una queja o reclamo sobre la atención en los centros de servicios o plataformas digitales.',
		duracion: 'Lectura 2 min',
		ruta: '/libro-reclamaciones/registrar',
		icon: 'book-open',
		etiquetas: 'libro reclamaciones queja reclamo atencion tramite',
	},
];
---

<Layout title="Guías Explicativas - SUNAT SOL" description="Centro de ayuda y guías paso a paso para todos los servicios de Operaciones en Línea.">
	<SolHeader current="inicio" />

	<div class="flex min-h-[calc(100vh-104px)] bg-[#f8fafc] dark:bg-slate-950">
		<SolSidebar activeMenu="ayuda" />

		<main class="flex-1 p-6 lg:p-8 max-w-7xl">
			<div class="space-y-6">
				<!-- Migas de Pan -->
				<nav class="flex text-xs font-semibold text-slate-500 dark:text-slate-400" aria-label="Ruta de navegación">
					<ol class="inline-flex items-center gap-1.5">
						<li><a href="/prueba" class="hover:text-[#0877a7] dark:hover:text-sky-300">Inicio SOL</a></li>
						<li><Icon name="chevron-right" size={12} /></li>
						<li><span>Ayuda</span></li>
						<li><Icon name="chevron-right" size={12} /></li>
						<li><span class="font-bold text-slate-800 dark:text-slate-200">Guías Explicativas</span></li>
					</ol>
				</nav>

				<!-- Encabezado y Buscador -->
				<div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
					<div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
						<div>
							<h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">
								Centro de Guías Explicativas y Tutoriales
							</h1>
							<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
								Encuentra manuales paso a paso para emitir comprobantes, presentar declaraciones y realizar trámites en línea.
							</p>
						</div>

						<!-- Input de Búsqueda -->
						<div class="relative w-full lg:w-80">
							<span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-slate-400">
								<Icon name="search" size={16} />
							</span>
							<input
								type="text"
								id="buscador-guias"
								placeholder="Buscar guía (ej. Factura, 621, GRE)..."
								class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2.5 pl-10 pr-4 text-sm font-medium text-slate-800 focus:border-[#0877a7] focus:bg-white focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-white"
							/>
						</div>
					</div>

					<!-- Pestañas de Categoría -->
					<div class="mt-5 flex flex-wrap gap-2 border-t border-slate-100 pt-4 dark:border-slate-800" id="filtros-categoria">
						<button
							type="button"
							data-cat="Todas"
							class="btn-cat rounded-xl bg-[#003366] px-3.5 py-1.5 text-xs font-extrabold text-white transition"
						>
							Todas ({catalogoGuias.length})
						</button>
						<button
							type="button"
							data-cat="Emitir"
							class="btn-cat rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-1.5 text-xs font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
						>
							Emitir Comprobantes
						</button>
						<button
							type="button"
							data-cat="Declarar y Pagar"
							class="btn-cat rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-1.5 text-xs font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
						>
							Declarar y Pagar
						</button>
						<button
							type="button"
							data-cat="Trámites y Clave SOL"
							class="btn-cat rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-1.5 text-xs font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
						>
							Trámites y Clave SOL
						</button>
					</div>
				</div>

				<!-- Cuadrícula de Guías -->
				<div id="grid-guias" class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
					{catalogoGuias.map((guia) => (
						<a
							href={guia.ruta}
							class="tarjeta-guia group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-[#0877a7] hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
							data-categoria={guia.categoria}
							data-busqueda={`${guia.titulo.toLowerCase()} ${guia.descripcion.toLowerCase()} ${guia.etiquetas}`}
						>
							<div class="space-y-3">
								<div class="flex items-center justify-between">
									<span class="grid h-11 w-11 place-items-center rounded-xl bg-sky-50 text-[#0877a7] transition group-hover:bg-[#003366] group-hover:text-white dark:bg-sky-950 dark:text-sky-400">
										<Icon name={guia.icon} size={22} />
									</span>
									<span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
										{guia.categoria}
									</span>
								</div>

								<h2 class="text-base font-extrabold text-slate-900 group-hover:text-[#0877a7] dark:text-white dark:group-hover:text-sky-400">
									{guia.titulo}
								</h2>

								<p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
									{guia.descripcion}
								</p>
							</div>

							<div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-3 text-xs dark:border-slate-800">
								<span class="font-medium text-slate-500">{guia.duracion}</span>
								<span class="inline-flex items-center gap-1 font-extrabold text-[#0877a7] dark:text-sky-400">
									Abrir guía
									<Icon name="arrow-right" size={14} />
								</span>
							</div>
						</a>
					))}
				</div>

				<!-- Estado vacío si no hay resultados -->
				<div id="guias-vacio" class="hidden rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center dark:border-slate-700 dark:bg-slate-900">
					<p class="text-sm font-bold text-slate-700 dark:text-slate-300">
						No se encontraron guías que coincidan con tu búsqueda.
					</p>
					<button
						type="button"
						id="btn-reset-guias"
						class="mt-3 rounded-xl bg-[#0877a7] px-4 py-2 text-xs font-extrabold text-white hover:bg-[#065f86]"
					>
						Ver todas las guías
					</button>
				</div>
			</div>
		</main>
	</div>

	<script src="../../scripts/guias-explicativas.js"></script>
</Layout>