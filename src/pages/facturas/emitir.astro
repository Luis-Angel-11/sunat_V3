---
import Layout from '../../layouts/Layout.astro';
import SolHeader from '../../components/sol/SolHeader.astro';
import SolSidebar from '../../components/sol/SolSidebar.astro';
import Icon from '../../components/Icon.astro';
---

<Layout title="Emitir Comprobante Electrónico - SUNAT SOL">
	<!-- 1. NUEVO HEADER DE SUNAT -->
	<SolHeader current="inicio" />

	<!-- 2. CONTENEDOR FLEX PRINCIPAL (SIDEBAR + CONTENIDO) -->
	<div class="flex min-h-[calc(100vh-104px)] bg-[#f8fafc] dark:bg-slate-950">
		
		<!-- SIDEBAR LATERAL (Marcado en 'emitir') -->
		<SolSidebar activeMenu="emitir" />

		<!-- CONTENIDO PRINCIPAL ENCUADRADO -->
		<main class="flex-1 p-6 lg:p-8 max-w-7xl">
			<div class="space-y-5">
				
				<!-- Migas de Pan -->
				<nav class="flex text-xs font-semibold text-slate-500 dark:text-slate-400 print:hidden" aria-label="Breadcrumb">
					<ol class="inline-flex items-center gap-1.5">
						<li><a href="/prueba" class="hover:text-[#0877a7] dark:hover:text-sky-300">Inicio SOL</a></li>
						<li><Icon name="chevron-right" size={12} /></li>
						<li><span class="text-slate-800 dark:text-slate-200 font-bold">Emisión de Comprobantes</span></li>
					</ol>
				</nav>

				<!-- BANNER CONTEXTUAL DE AYUDA -->
				<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 rounded-2xl border border-sky-200 bg-sky-50/80 p-4 dark:border-sky-900/60 dark:bg-sky-950/40 print:hidden">
					<div class="flex items-center gap-3">
						<span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-[#003366] text-white dark:bg-sky-500 dark:text-slate-950">
							<Icon name="info" size={20} />
						</span>
						<div>
							<p class="text-xs font-bold text-slate-900 dark:text-white">
								¿Es tu primera vez facturando o necesitas ayuda con algún campo?
							</p>
							<p class="text-[11px] text-slate-600 dark:text-slate-300">
								Consulta nuestra guía paso a paso con video tutorial integrado para resolver tus dudas antes de emitir.
							</p>
						</div>
					</div>

					<a href="/ayuda/factura" class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-xl bg-[#0877a7] px-4 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-[#075782] dark:bg-sky-600 dark:hover:bg-sky-500">
						<span>Ver Guía y Video Tutorial</span>
						<Icon name="arrow-right" size={14} />
					</a>
				</div>

				<!-- CONTENEDOR PRINCIPAL DEL SISTEMA DE FACTURACIÓN -->
				<form id="form-facturador" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 space-y-6 print:hidden" novalidate>
					
					<!-- CABECERA: Datos del Emisor y Fechas -->
					<div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between border-b border-slate-100 pb-5 dark:border-slate-800">
						<div class="flex items-start gap-3">
							<div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-[#003366] text-white font-black text-xs shadow-sm dark:bg-slate-900">
	JC
</div>
							<div>
								<h2 class="text-sm font-extrabold text-slate-900 dark:text-white uppercase tracking-tight">
									Cordova Ramos Javier
								</h2>
								<p class="text-xs text-slate-500 dark:text-slate-400">
									RUC: 10616288475 - AV. UNIVERSITARIA NRO. 8411 DPTO. 1536 (COMAS LIMA)
								</p>
								<p class="text-xs text-slate-500 dark:text-slate-400">
									gerente.gen.2025@gmail.com - 932547945
								</p>
							</div>
						</div>

						<div class="flex items-center gap-3 self-end md:self-auto">
							<div>
								<label for="fec-emision" class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">
									Fec. Emisión
								</label>
								<input type="date" id="fec-emision" value="2026-10-31" class="h-9 rounded-lg border border-slate-300 bg-slate-50 px-3 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200" />
							</div>

							<div>
								<label for="fec-vencimiento" class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">
									Fec. Vencimiento
								</label>
								<input type="date" id="fec-vencimiento" value="2026-10-31" class="h-9 rounded-lg border border-slate-300 bg-slate-50 px-3 text-xs font-semibold text-slate-800 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200" />
							</div>
						</div>
					</div>

					<!-- FILA DE PARÁMETROS DEL COMPROBANTE -->
					<div class="grid gap-3 sm:grid-cols-2 md:grid-cols-5">
						<div>
							<label for="tipo-comprobante" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
								Tipo comprobante
							</label>
							<select id="tipo-comprobante" class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-xs text-slate-900 font-semibold dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
								<option value="FACTURA">FACTURA ELECTRÓNICA</option>
								<option value="BOLETA">BOLETA DE VENTA ELECTRÓNICA</option>
							</select>
						</div>

						<div>
							<label for="serie-comprobante" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
								Serie
							</label>
							<select id="serie-comprobante" class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-xs text-slate-900 font-semibold dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
								<option value="F001">F001</option>
								<option value="F002">F002</option>
							</select>
						</div>

						<div>
							<label for="tipo-operacion" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
								Tipo Operación
							</label>
							<select id="tipo-operacion" class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
								<option value="1">Venta interna</option>
								<option value="2">Exportación</option>
							</select>
						</div>

						<div>
							<label for="moneda" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
								Moneda
							</label>
							<select id="moneda" class="h-9 w-full rounded-lg border border-slate-300 bg-white px-3 text-xs text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
								<option value="PEN">Soles</option>
								<option value="USD">Dólares Americanos</option>
							</select>
						</div>

						<div>
							<label for="tipo-cambio" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
								Tipo de cambio
							</label>
							<input type="text" id="tipo-cambio" value="3.467" readonly class="h-9 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 text-xs font-semibold text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-400" />
						</div>
					</div>

					<!-- BÚSQUEDA Y VALIDACIÓN DE CLIENTE -->
					<div class="space-y-1">
						<label for="cliente-search" class="block text-xs font-bold text-slate-800 dark:text-slate-200">
							Cliente <button type="button" id="btn-abrir-modal-cliente" class="text-[#0877a7] dark:text-sky-400 font-semibold cursor-pointer hover:underline focus:outline-none">[+ Nuevo]</button>
						</label>
						<div class="relative">
							<input type="text" id="cliente-search" placeholder="Escriba el número de RUC (11 dígitos)" class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-xs text-slate-900 placeholder:text-slate-400 focus:border-[#0877a7] focus:ring-1 focus:ring-[#0877a7] dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
						</div>
						<p id="cliente-feedback" class="text-xs font-semibold hidden"></p>
					</div>

					<!-- TABLA DE PRODUCTOS -->
					<div class="space-y-3 pt-2">
						<div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
							<table class="w-full text-left text-xs">
								<thead class="bg-slate-50 text-slate-700 dark:bg-slate-800 dark:text-slate-300 font-bold">
									<tr>
										<th class="p-3">Descripción</th>
										<th class="p-3">Unidad</th>
										<th class="p-3 w-20 text-center">Cantidad</th>
										<th class="p-3 w-28 text-right">Valor Unit.</th>
										<th class="p-3 w-28 text-right">Precio Unit.</th>
										<th class="p-3 w-28 text-right">Subtotal</th>
										<th class="p-3 w-28 text-right">Total</th>
									</tr>
								</thead>
								<tbody id="tabla-productos" class="divide-y divide-slate-100 dark:divide-slate-800">
								</tbody>
							</table>
						</div>

						<div class="flex items-center justify-between">
							<button type="button" id="btn-modal-producto" class="inline-flex items-center gap-2 rounded-xl bg-[#0877a7] px-4 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-[#075782]">
								<span>Agregar Producto</span>
								<span class="rounded bg-white/20 px-1.5 py-0.5 text-[10px]">F2</span>
							</button>
							<span id="txt-total-items" class="text-xs font-semibold text-slate-500 dark:text-slate-400">Total de ítems: 0</span>
						</div>
					</div>

					<!-- PIE DE TOTALES Y SECCIÓN DE PAGOS -->
					<div class="space-y-4 pt-4 border-t border-slate-100 dark:border-slate-800">
						<div class="flex flex-col items-end gap-1.5 text-xs">
							<div class="flex justify-between w-64 text-slate-600 dark:text-slate-400">
								<span class="font-bold">OP. GRAVADA:</span>
								<span id="txt-subtotal" class="font-bold text-slate-800 dark:text-slate-200">0.00</span>
							</div>
							<div class="flex justify-between w-64 text-slate-600 dark:text-slate-400">
								<span class="font-bold">IGV (18%):</span>
								<span id="txt-igv" class="font-bold text-slate-800 dark:text-slate-200">0.00</span>
							</div>
							<div class="flex justify-between w-64 text-slate-600 dark:text-slate-400">
								<span class="font-bold">OTROS CARGOS:</span>
								<input type="number" value="0" class="w-20 text-right h-6 border rounded px-1 dark:bg-slate-950" />
							</div>
							<div class="flex justify-between w-64 text-sm font-extrabold text-slate-900 dark:text-white pt-2 border-t border-slate-200 dark:border-slate-700">
								<span>TOTAL A PAGAR:</span>
								<span id="txt-total" class="text-[#0877a7] dark:text-sky-400">0.00</span>
							</div>
						</div>

						<div class="grid gap-3 sm:grid-cols-2 md:grid-cols-4 bg-slate-50 dark:bg-slate-950 p-4 rounded-xl border border-slate-200 dark:border-slate-800">
							<div>
								<label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Condición de Pago</label>
								<select id="condicion-pago" class="h-9 w-full rounded border border-slate-300 px-2 text-xs dark:border-slate-700 dark:bg-slate-900">
									<option value="Contado">Contado</option>
									<option value="Crédito">Crédito</option>
								</select>
							</div>
							<div>
								<label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Método de pago</label>
								<select class="h-9 w-full rounded border border-slate-300 px-2 text-xs dark:border-slate-700 dark:bg-slate-900">
									<option value="Efectivo">Efectivo</option>
									<option value="Transferencia">Transferencia</option>
								</select>
							</div>
							<div>
								<label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Destino</label>
								<select class="h-9 w-full rounded border border-slate-300 px-2 text-xs dark:border-slate-700 dark:bg-slate-900">
									<option value="CAJA GENERAL">CAJA GENERAL</option>
								</select>
							</div>
							<div>
								<label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1">Monto Pago</label>
								<input type="text" id="monto-pago-input" value="0.00" readonly class="h-9 w-full rounded border border-slate-200 bg-slate-100 px-3 text-xs font-bold text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200" />
							</div>
						</div>

						<!-- ACCIONES -->
						<div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3 pt-2">
							<button type="button" id="btn-vista-previa" class="inline-flex h-10 items-center justify-center rounded-xl bg-emerald-600 px-6 text-xs font-bold text-white shadow-md transition hover:bg-emerald-700">
								Vista Previa
							</button>

							<a href="/prueba" class="inline-flex h-10 items-center justify-center rounded-xl border border-slate-300 bg-white px-5 text-xs font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300">
								Cancelar
							</a>

							<button type="submit" class="inline-flex h-10 items-center justify-center gap-2 rounded-xl bg-[#0877a7] px-6 text-xs font-bold text-white shadow-md transition hover:bg-[#075782]">
								<span>Generar Factura</span>
								<span class="rounded bg-white/20 px-1.5 py-0.5 text-[10px]">ALT + S</span>
							</button>
						</div>
					</div>
				</form>

				<!-- MODALES (CLIENTE, PRODUCTO, VISTA PREVIA Y ÉXITO) -->
				<div id="modal-cliente" hidden class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm overflow-y-auto print:hidden">
					<div class="w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900 space-y-4 my-8">
						<div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
							<h3 class="text-base font-bold text-slate-900 dark:text-white">Nuevo Cliente</h3>
							<button type="button" id="btn-cerrar-modal-cliente" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 font-bold">✕</button>
						</div>

						<div class="flex border-b border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-500">
							<button type="button" class="px-4 py-2 text-[#0877a7] border-b-2 border-[#0877a7] font-bold bg-slate-50 dark:bg-slate-800 rounded-t-lg">Datos de Cliente</button>
							<button type="button" class="px-4 py-2 hover:text-slate-800 dark:hover:text-slate-200">Dirección</button>
							<button type="button" class="px-4 py-2 hover:text-slate-800 dark:hover:text-slate-200">Otros Datos</button>
						</div>

						<div id="mc-feedback" class="hidden text-xs font-semibold p-2.5 rounded-lg"></div>

						<div class="space-y-4 text-xs">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
								<div>
									<label class="block font-bold mb-1 text-slate-700 dark:text-slate-300">Tipo Doc. Identidad <span class="text-rose-500">*</span></label>
									<select id="mc-tipo-doc" class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 font-semibold">
										<option value="RUC">RUC</option>
										<option value="DNI">DNI</option>
									</select>
								</div>

								<div>
									<label class="block font-bold mb-1 text-slate-700 dark:text-slate-300">Número <span class="text-rose-500">*</span></label>
									<div class="flex items-center gap-1">
										<div class="relative w-full">
											<input type="text" id="mc-numero" placeholder="Escriba número" maxlength="11" class="h-9 w-full rounded-l-lg border border-slate-300 px-3 text-xs pr-12 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
											<span id="mc-contador-doc" class="absolute right-2 top-2.5 text-[10px] font-semibold text-slate-400">0/11</span>
										</div>
										<button type="button" id="btn-consultar-sunat" class="h-9 shrink-0 inline-flex items-center justify-center gap-1 rounded-r-lg bg-[#0877a7] px-4 text-xs font-bold text-white shadow-sm hover:bg-[#075782] transition">
											🔍 CONSULTAR
										</button>
									</div>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
								<div>
									<label class="block font-bold mb-1 text-slate-700 dark:text-slate-300">Nombre / Razón Social <span class="text-rose-500">*</span></label>
									<input type="text" id="mc-nombre" placeholder="Nombre completo o Razón Social" class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
								</div>
								<div>
									<label class="block font-bold mb-1 text-slate-700 dark:text-slate-300">Nombre comercial</label>
									<input type="text" id="mc-nombre-comercial" class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
								<div>
									<label class="block font-bold mb-1 text-slate-700 dark:text-slate-300">Días de crédito</label>
									<input type="number" id="mc-dias-credito" value="0" class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
								</div>
								<div>
									<label class="block font-bold mb-1 text-slate-700 dark:text-slate-300">Código interno</label>
									<input type="text" id="mc-codigo-interno" class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
								</div>
								<div>
									<label class="block font-bold mb-1 text-slate-700 dark:text-slate-300">Nacionalidad</label>
									<select class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
										<option>PERU</option>
										<option>EXTRANJERO</option>
									</select>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
								<div>
									<label class="block font-bold mb-1 text-slate-700 dark:text-slate-300">Tipo de cliente</label>
									<select class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
										<option value="">Seleccionar</option>
										<option value="Final">Cliente Final</option>
										<option value="Mayorista">Mayorista</option>
									</select>
								</div>
								<div>
									<label class="block font-bold mb-1 text-slate-700 dark:text-slate-300">Código de barra</label>
									<input type="text" id="mc-codigo-barra" class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
								</div>
							</div>
						</div>

						<div class="flex justify-end gap-2 pt-3 border-t border-slate-100 dark:border-slate-800">
							<button type="button" id="btn-cancelar-modal-cliente" class="rounded-xl border border-slate-300 px-5 py-2 text-xs font-bold text-slate-700 dark:border-slate-700 dark:text-slate-300">
								Cancelar
							</button>
							<button type="button" id="btn-guardar-cliente" class="rounded-xl bg-[#0877a7] px-6 py-2 text-xs font-bold text-white transition hover:bg-[#075782]">
								Guardar
							</button>
						</div>
					</div>
				</div>

				<div id="modal-producto" hidden class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm overflow-y-auto print:hidden">
					<div class="w-full max-w-3xl rounded-2xl border border-slate-200 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900 space-y-4 my-8">
						<div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
							<h3 id="modal-titulo" class="text-base font-bold text-slate-900 dark:text-white">Nuevo Producto</h3>
							<button type="button" id="btn-cerrar-modal" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 font-bold">✕</button>
						</div>

						<div id="mp-feedback" class="hidden text-xs font-semibold p-2.5 rounded-lg"></div>

						<div class="space-y-4 text-xs">
							<div class="flex flex-wrap gap-4 text-slate-700 dark:text-slate-300">
								<label class="flex items-center gap-1.5"><input type="checkbox" id="m-inc-igv" checked /> Incluye Igv</label>
								<label class="flex items-center gap-1.5"><input type="checkbox" /> Calcular cantidad por precio</label>
								<label class="flex items-center gap-1.5"><input type="checkbox" /> Impuesto a la Bolsa Plástica</label>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
								<div>
									<label class="block font-bold mb-1 text-slate-700 dark:text-slate-300">Nombre <span class="text-rose-500">*</span></label>
