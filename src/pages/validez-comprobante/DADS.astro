---
import Icon from '../../components/Icon.astro';
import SolLayout from '../../layouts/SolLayout.astro';
---

<SolLayout
	title="Consultar la validez de un comprobante"
	description="Comprueba en línea si un comprobante de pago fue informado a SUNAT."
	current="validez"
>
	<div class="container-sunat py-6">
		<nav aria-label="Ruta de navegación" class="text-sm">
			<ol class="flex flex-wrap items-center gap-1.5 text-slate-500 dark:text-slate-400">
				<li><a href="/sol" class="link-sunat">Inicio</a></li>
				<li aria-hidden="true"><Icon name="chevron-right" size={14} /></li>
				<li><a href="/validez-comprobante" class="link-sunat">Consultar validez</a></li>
				<li aria-hidden="true"><Icon name="chevron-right" size={14} /></li>
				<li aria-current="page" class="font-semibold text-slate-800 dark:text-slate-200">Servicio en línea</li>
			</ol>
		</nav>

		<div class="mt-4 flex flex-wrap items-end justify-between gap-3">
			<div class="min-w-0">
				<h1 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">
					Consultar la validez de un comprobante
				</h1>

				<div class="mt-3 rounded-2xl border border-sky-200 bg-sky-50 p-4 dark:border-sky-900 dark:bg-sky-950/40">
					<p class="flex items-center gap-2 text-sm font-bold text-sunat-blue dark:text-sky-300">
						<Icon name="info" size={17} />
						¿Qué hace esta consulta?
					</p>
					<p class="mt-1 text-sm leading-relaxed text-slate-700 dark:text-slate-200">
						Te ayuda a revisar si un documento de pago —por ejemplo una factura, una boleta o un recibo por
						honorarios— realmente fue emitido y registrado en SUNAT. Así puedes darte cuenta a tiempo si es
						falso, si tiene datos equivocados o si nunca existió.
					</p>
					<p class="mt-2 text-xs text-slate-600 dark:text-slate-400">
						Es gratis. Si consultas un solo documento, no necesitas Clave SOL.
					</p>
				</div>

				<p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
					Completa los datos del documento. Si no sabes dónde está cada uno, usa la guía visual de la derecha.
				</p>
			</div>
			<a href="/validez-comprobante" class="link-sunat inline-flex items-center gap-1 text-sm">
				<Icon name="arrow-left" size={15} />Volver a la guía
			</a>
		</div>

		<div class="mt-5 grid items-start gap-6 md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
			<!-- Formulario -->
			<section class="sol-panel min-w-0" aria-labelledby="titulo-formulario">
				<h2 id="titulo-formulario" class="flex items-center gap-2 text-lg font-bold text-slate-900 dark:text-white">
					<Icon name="file-text" size={20} class="text-sunat-blue dark:text-sky-300" />
					Datos del comprobante
				</h2>
				<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
					Los campos con <span aria-hidden="true" class="font-bold text-red-600 dark:text-rose-400">*</span> son obligatorios.
				</p>

				<form id="validezForm" class="mt-5 grid gap-4">
					<div>
						<label for="tipoComprobante" class="sol-label">Tipo de comprobante *</label>
						<select id="tipoComprobante" name="tipoComprobante" class="sol-input" required>
							<option value="RECIBO POR HONORARIOS ELECTRÓNICO" selected>Recibo por honorarios electrónico</option>
							<option value="FACTURA ELECTRÓNICA">Factura electrónica</option>
							<option value="BOLETA DE VENTA ELECTRÓNICA">Boleta de venta electrónica</option>
							<option value="LIQUIDACIÓN DE COMPRA">Liquidación de compra</option>
							<option value="NOTA DE CRÉDITO ELECTRÓNICA">Nota de crédito electrónica</option>
							<option value="NOTA DE DÉBITO ELECTRÓNICA">Nota de débito electrónica</option>
						</select>
					</div>

					<div>
						<label for="rucEmisor" class="sol-label">RUC del emisor *</label>
						<p id="ruc-emisor-ayuda" class="mb-1.5 text-xs text-slate-500 dark:text-slate-400">Es el RUC de quien emitió el comprobante (11 dígitos).</p>
						<input
							type="text"
							id="rucEmisor"
							name="rucEmisor"
							inputmode="numeric"
							maxlength="11"
							placeholder="Ej.: 10458923101"
							aria-describedby="ruc-emisor-ayuda"
							data-target="zone-emisor-ruc"
							data-label="RUC del emisor"
							class="sol-input"
							required
						/>
					</div>

					<div class="grid gap-4 sm:grid-cols-2">
						<div>
							<label for="tipoDocReceptor" class="sol-label">Documento del cliente *</label>
							<select id="tipoDocReceptor" name="tipoDocReceptor" class="sol-input" data-target="zone-receptor" data-label="Documento del cliente">
								<option value="RUC" selected>RUC</option>
								<option value="DNI">DNI</option>
								<option value="Carné de extranjería">Carné de extranjería</option>
								<option value="Pasaporte">Pasaporte</option>
								<option value="Sin documento">Sin documento</option>
							</select>
						</div>
						<div>
							<label for="numDocReceptor" class="sol-label">Número del documento *</label>
							<input
								type="text"
								id="numDocReceptor"
								name="numDocReceptor"
								inputmode="numeric"
								placeholder="Ej.: 20601234567"
								aria-describedby="num-doc-ayuda"
								data-target="zone-receptor"
								data-label="Número del cliente"
								class="sol-input"
								required
							/>
							<p id="num-doc-ayuda" class="mt-1 text-xs text-slate-500 dark:text-slate-400">RUC o DNI de quien recibió el servicio.</p>
						</div>
					</div>

					<fieldset>
						<legend class="sol-label">Número del comprobante *</legend>
						<div class="grid grid-cols-[110px_minmax(0,1fr)] gap-2">
							<input
								type="text"
								id="serie"
								name="serie"
								maxlength="4"
								placeholder="E001"
								aria-label="Serie del comprobante"
								data-target="zone-numero"
								data-label="Serie"
								class="sol-input uppercase"
								required
							/>
							<input
								type="text"
								id="correlativo"
								name="correlativo"
								inputmode="numeric"
								placeholder="Ej.: 142"
								aria-label="Número o correlativo del comprobante"
								data-target="zone-numero"
								data-label="Número del comprobante"
								class="sol-input"
								required
							/>
						</div>
						<p class="mt-1 text-xs text-slate-500 dark:text-slate-400">La serie suele tener 4 caracteres, por ejemplo E001. El número es el correlativo.</p>
					</fieldset>

					<div class="grid gap-4 sm:grid-cols-2">
						<div>
							<label for="fechaEmision" class="sol-label">Fecha de emisión *</label>
							<input
								type="date"
								id="fechaEmision"
								name="fechaEmision"
								data-target="zone-fecha"
								data-label="Fecha de emisión"
								class="sol-input"
								required
							/>
						</div>
						<div>
							<label for="importeTotal" class="sol-label">Importe total (S/) *</label>
							<input
								type="number"
								id="importeTotal"
								name="importeTotal"
								inputmode="decimal"
								step="0.01"
								min="0"
								placeholder="Ej.: 3500.00"
								aria-describedby="importe-ayuda"
								data-target="zone-monto"
								data-label="Importe total"
								class="sol-input"
								required
							/>
							<p id="importe-ayuda" class="mt-1 text-xs text-slate-500 dark:text-slate-400">Hasta 15 enteros y 2 decimales.</p>
						</div>
					</div>

					<button type="submit" class="sol-btn-primary mt-1 h-12 text-base">
						<Icon name="shield-check" size={18} />
						Consultar validez
					</button>
				</form>
			</section>

			<!-- Guía visual -->
			<section class="sol-panel min-w-0" aria-labelledby="titulo-guia">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<h2 id="titulo-guia" class="flex items-center gap-2 text-lg font-bold text-slate-900 dark:text-white">
						<Icon name="search" size={20} class="text-sunat-blue dark:text-sky-300" />
						Guía visual
					</h2>
					<span class="rounded-full bg-sky-50 px-2.5 py-1 text-xs font-bold text-sunat-blue dark:bg-sky-500/15 dark:text-sky-300">
						Enfoca un campo
					</span>
				</div>
				<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
					Este es un recibo de ejemplo. Al tocar o enfocar un campo, marcamos dónde está ese dato.
				</p>

				<div class="rhe-document mt-4">
					<div class="flex flex-col gap-3 sm:flex-row sm:justify-between">
						<div class="sm:w-[55%]">
							<p class="text-sm font-bold text-slate-900">VALDEZ MENDOZA CLAUDIA LUCÍA</p>
							<p>ARQUITECTURA Y DISEÑO DE INTERIORES</p>
							<p>AV. LOS LAURELES 450, DPTO. 302 - MIRAFLORES</p>
							<p>TELÉFONO: (01) 489-2210</p>
						</div>
						<div class="border-2 border-slate-900 p-3 text-center sm:w-[40%]">
							<div id="zone-emisor-ruc" class="highlight-zone">
								<p class="text-sm font-bold">R.U.C. 10458923101</p>
							</div>
							<p class="mt-2 text-[11px] font-bold leading-tight">RECIBO POR HONORARIOS ELECTRÓNICO</p>
							<div id="zone-numero" class="highlight-zone mt-1">
								<p class="font-bold">Nro. E001 - 142</p>
							</div>
						</div>
					</div>

					<div class="mt-5 grid gap-1.5">
						<p><strong>Recibí de:</strong> CONSTRUCTORA E INMOBILIARIA HORIZONTE S.A.C.</p>
						<p id="zone-receptor" class="highlight-zone"><strong>Identificado con:</strong> RUC <strong>N.º</strong> 20601234567</p>
						<p><strong>Domicilio del cliente:</strong> AV. JAVIER PRADO ESTE 2450 - SAN BORJA</p>
						<p><strong>Forma de pago:</strong> AL CONTADO</p>
						<p><strong>Por concepto de:</strong> SUPERVISIÓN DE PROYECTO ARQUITECTÓNICO</p>
						<p id="zone-fecha" class="highlight-zone mt-3"><strong>Fecha de emisión:</strong> 12 de mayo de 2026</p>
					</div>

					<div class="mt-6 flex justify-end">
						<div class="grid w-full max-w-[260px] gap-1">
							<div id="zone-monto" class="highlight-zone flex justify-between gap-3">
								<strong>Total por honorarios:</strong>
								<span>3,500.00</span>
							</div>
							<div class="flex justify-between gap-3">
								<span>Retención (8 %) IR:</span>
								<span>(280.00)</span>
							</div>
							<div class="mt-1 flex justify-between gap-3 border-t border-slate-300 pt-1 font-bold">
								<span>Total neto recibido:</span>
								<span>3,220.00</span>
							</div>
						</div>
					</div>
				</div>

				<p class="mt-3 flex items-start gap-2 text-xs text-slate-500 dark:text-slate-400">
					<Icon name="info" size={15} class="mt-0.5 shrink-0" />
					Los datos del recibo son solo un ejemplo. No uses estos valores para tu consulta.
				</p>
			</section>
		</div>
	</div>

	<!-- Resultado de la consulta -->
	<dialog id="modal-validez" class="sol-dialog max-w-lg" aria-labelledby="modal-titulo">
		<div class="modal-no-print flex items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-950/60">
			<h2 id="modal-titulo" class="font-bold text-slate-900 dark:text-white">Resultado de la consulta</h2>
			<button type="button" data-cerrar aria-label="Cerrar resultado" class="grid h-9 w-9 place-items-center rounded-full text-slate-500 transition hover:bg-slate-200 dark:text-slate-400 dark:hover:bg-slate-800">
				<Icon name="x" size={18} />
			</button>
		</div>

		<div class="p-5">
			<div class="flex items-center gap-3 rounded-xl border border-emerald-300 bg-emerald-50 p-4 dark:border-emerald-700 dark:bg-emerald-500/10">
				<span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-emerald-600 text-white dark:bg-emerald-500 dark:text-slate-950">
					<Icon name="check" size={22} strokeWidth={3} />
				</span>
				<div>
					<p class="font-bold text-emerald-900 dark:text-emerald-200">Comprobante válido</p>
					<p id="modal-sub" class="text-sm text-emerald-800 dark:text-emerald-300">El comprobante está registrado e informado a SUNAT.</p>
				</div>
			</div>

			<dl class="mt-4 divide-y divide-dashed divide-slate-300 rounded-xl border border-slate-200 px-4 py-2 text-sm dark:divide-slate-700 dark:border-slate-700">
				<div class="flex justify-between gap-4 py-2">
					<dt class="text-slate-500 dark:text-slate-400">Tipo de comprobante</dt>
					<dd id="res-tipo" class="text-right font-semibold text-slate-900 dark:text-slate-100">—</dd>
				</div>
				<div class="flex justify-between gap-4 py-2">
					<dt class="text-slate-500 dark:text-slate-400">Serie y número</dt>
					<dd id="res-numero" class="text-right font-semibold text-slate-900 dark:text-slate-100">—</dd>
				</div>
				<div class="flex justify-between gap-4 py-2">
					<dt class="text-slate-500 dark:text-slate-400">RUC del emisor</dt>
					<dd id="res-ruc" class="text-right font-semibold text-slate-900 dark:text-slate-100">—</dd>
				</div>
				<div class="flex justify-between gap-4 py-2">
					<dt class="text-slate-500 dark:text-slate-400">Documento del cliente</dt>
					<dd id="res-doc" class="text-right font-semibold text-slate-900 dark:text-slate-100">—</dd>
				</div>
				<div class="flex justify-between gap-4 py-2">
					<dt class="text-slate-500 dark:text-slate-400">Fecha de emisión</dt>
					<dd id="res-fecha" class="text-right font-semibold text-slate-900 dark:text-slate-100">—</dd>
				</div>
				<div class="flex justify-between gap-4 py-2">
					<dt class="text-slate-500 dark:text-slate-400">Importe total</dt>
					<dd id="res-importe" class="text-right font-semibold text-slate-900 dark:text-slate-100">—</dd>
				</div>
			</dl>

			<p class="mt-3 flex items-start gap-2 text-xs text-slate-500 dark:text-slate-400">
				<Icon name="info" size={15} class="mt-0.5 shrink-0" />
				Esta es una demostración del prototipo. La consulta real se hace en el servicio de SUNAT.
			</p>
		</div>

		<div class="modal-no-print flex flex-col-reverse gap-2 border-t border-slate-200 bg-slate-50 px-5 py-4 sm:flex-row sm:justify-end dark:border-slate-800 dark:bg-slate-950/60">
			<button type="button" data-cerrar class="sol-btn-secondary">Cerrar</button>
			<button type="button" data-pdf class="sol-btn-primary">
				<Icon name="download" size={16} /><span data-pdf-texto>Descargar en PDF</span>
			</button>
		</div>
	</dialog>

	<style>
		.rhe-document {
			border: 1px solid #94a3b8;
			background: #fff;
			color: #0f172a;
			box-shadow: 0 2px 8px rgb(0 0 0 / 0.08);
			font-family: Arial, Helvetica, sans-serif;
			font-size: 0.8rem;
			line-height: 1.5;
			padding: 1.25rem;
		}

		.highlight-zone {
			position: relative;
			border-radius: 4px;
			padding: 2px 4px;
			transition:
				background-color 200ms ease,
				outline-color 200ms ease;
		}

		.highlight-zone.active {
			outline: 2.5px solid #e11d48;
			background-color: rgb(225 29 72 / 0.12);
		}

		.highlight-zone.active::after {
			content: attr(data-hint);
			position: absolute;
			bottom: calc(100% + 4px);
			left: 0;
			z-index: 10;
			white-space: nowrap;
			border-radius: 4px;
			background: #e11d48;
			color: #fff;
			padding: 2px 8px;
			font-size: 0.68rem;
			font-weight: 700;
		}

		@media (max-width: 480px) {
			.highlight-zone.active::after {
				white-space: normal;
				width: max-content;
				max-width: 160px;
			}
		}

	</style>

	<style is:global>
		@media print {
			body * {
				visibility: hidden;
			}

			#modal-validez,
			#modal-validez * {
				visibility: visible;
			}

			#modal-validez {
				position: absolute;
				inset: 0;
				margin: 0;
				width: 100%;
				max-width: none;
				border: 0;
				box-shadow: none;
			}

			.modal-no-print {
				display: none !important;
			}
		}
	</style>

	<script>
		import { descargarConstanciaPDF } from '../../lib/constancia-pdf';

		(() => {
			const form = document.querySelector('#validezForm');
			const modal = document.querySelector('#modal-validez');
			const zonas = [...document.querySelectorAll('.highlight-zone')];
			const campos = [...document.querySelectorAll('[data-target]')];

			const limpiarZonas = () =>
				zonas.forEach((zona) => {
					zona.classList.remove('active');
					zona.removeAttribute('data-hint');
				});

			const resaltar = (id, texto) => {
				limpiarZonas();
				const zona = document.getElementById(id);
				if (!zona) return;
				zona.classList.add('active');
				zona.dataset.hint = texto || 'Dato del comprobante';
				zona.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			};

			campos.forEach((campo) => {
				const activar = () => resaltar(campo.dataset.target, campo.dataset.label);
				campo.addEventListener('focus', activar);
				campo.addEventListener('mouseenter', activar);
			});

			document.addEventListener('click', (event) => {
				const target = event.target instanceof Element ? event.target : null;
				if (!target) return;
				if (!target.closest('input, select, .highlight-zone')) limpiarZonas();
			});

			const formatearFecha = (value) => {
				if (!value) return '—';
				const [year, month, day] = value.split('-');
				return `${day}/${month}/${year}`;
			};

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				const serie = document.querySelector('#serie').value.trim().toUpperCase();
				const correlativo = document.querySelector('#correlativo').value.trim();
				const ruc = document.querySelector('#rucEmisor').value.trim();
				const tipoDoc = document.querySelector('#tipoDocReceptor').value;
				const numDoc = document.querySelector('#numDocReceptor').value.trim();
				const fecha = document.querySelector('#fechaEmision').value;
				const importe = Number.parseFloat(document.querySelector('#importeTotal').value || '0');
				const tipo = document.querySelector('#tipoComprobante').value;
				const total = new Intl.NumberFormat('es-PE', {
					minimumFractionDigits: 2,
					maximumFractionDigits: 2,
				}).format(importe);

				document.querySelector('#res-tipo').textContent = tipo;
				document.querySelector('#res-numero').textContent = `${serie}-${correlativo}`;
				document.querySelector('#res-ruc').textContent = ruc;
				document.querySelector('#res-doc').textContent = `${tipoDoc} ${numDoc}`.trim();
				document.querySelector('#res-fecha').textContent = formatearFecha(fecha);
				document.querySelector('#res-importe').textContent = `S/ ${total}`;

				if (typeof modal.showModal === 'function') modal.showModal();
				else modal.setAttribute('open', '');
			});

			const generarPDF = async () => {
				const boton = document.querySelector('[data-pdf]');
				const textoBoton = document.querySelector('[data-pdf-texto]');
				if (boton) {
					boton.disabled = true;
					boton.setAttribute('aria-busy', 'true');
				}
				if (textoBoton) textoBoton.textContent = 'Generando PDF…';

				const datos = {
					tipo: document.querySelector('#res-tipo')?.textContent?.trim() || '—',
					numero: document.querySelector('#res-numero')?.textContent?.trim() || '—',
					ruc: document.querySelector('#res-ruc')?.textContent?.trim() || '—',
					documento: document.querySelector('#res-doc')?.textContent?.trim() || '—',
					fecha: document.querySelector('#res-fecha')?.textContent?.trim() || '—',
					importe: document.querySelector('#res-importe')?.textContent?.trim() || '—',
				};

				try {
					await descargarConstanciaPDF(datos);
				} finally {
					if (boton) {
						boton.disabled = false;
						boton.removeAttribute('aria-busy');
					}
					if (textoBoton) textoBoton.textContent = 'Descargar en PDF';
				}
			};

			document.addEventListener('click', (event) => {
				const target = event.target instanceof Element ? event.target : null;
				if (!target) return;
				if (target.closest('[data-cerrar]')) {
					modal.close();
				} else if (target.closest('[data-pdf]')) {
					generarPDF();
				}
			});

			modal.addEventListener('click', (event) => {
				if (event.target === modal) {
					const rect = modal.getBoundingClientRect();
					const fuera =
						event.clientX < rect.left ||
						event.clientX > rect.right ||
						event.clientY < rect.top ||
						event.clientY > rect.bottom;
					if (fuera) modal.close();
				}
			});
		})();
	</script>
</SolLayout>
