---
import Layout from '../../layouts/Layout.astro';
import SolHeader from '../../components/sol/SolHeader.astro';
import SolSidebar from '../../components/sol/SolSidebar.astro';
import Icon from '../../components/Icon.astro';
---

<Layout title="Validez del Comprobante de Pago Electrónico - SUNAT SOL">
	<!-- 1. HEADER OFICIAL UNIFICADO -->
	<SolHeader current="inicio" />

	<!-- 2. CONTENEDOR FLEX PRINCIPAL (SIDEBAR + CONTENIDO) -->
	<div class="flex min-h-[calc(100vh-104px)] bg-[#f8fafc] dark:bg-slate-950">
		
		<!-- SIDEBAR LATERAL (Activado en 'consultar') -->
		<SolSidebar activeMenu="consultar" />

		<!-- CONTENIDO PRINCIPAL ENCUADRADO -->
		<main class="flex-1 p-6 lg:p-8 max-w-7xl print:hidden">
			<div class="space-y-6">
				
				<!-- Migas de Pan -->
				<nav class="flex text-xs font-semibold text-slate-500 dark:text-slate-400 print:hidden" aria-label="Breadcrumb">
					<ol class="inline-flex items-center gap-1.5">
						<li><a href="/prueba" class="hover:text-[#0877a7] dark:hover:text-sky-300">Inicio SOL</a></li>
						<li><Icon name="chevron-right" size={12} /></li>
						<li><a href="/sol/consultar" class="hover:text-[#0877a7] dark:hover:text-sky-300">Consultar</a></li>
						<li><Icon name="chevron-right" size={12} /></li>
						<li><span class="text-slate-800 dark:text-slate-200 font-bold">Validez del Comprobante (CPE)</span></li>
					</ol>
				</nav>

				<!-- BANNER CONTEXTUAL DE AYUDA -->
				<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 rounded-2xl border border-sky-200 bg-sky-50/80 p-4 dark:border-sky-900/60 dark:bg-sky-950/40 print:hidden">
					<div class="flex items-center gap-3">
						<span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-[#003366] text-white dark:bg-sky-500 dark:text-slate-950">
							<Icon name="info" size={20} />
						</span>
						<div>
							<h2 class="text-xs font-bold text-slate-900 dark:text-white">
								¿Dudas sobre la autenticidad o validez de un comprobante recibido?
							</h2>
							<p class="text-[11px] text-slate-600 dark:text-slate-300">
								Escanea el código QR con la cámara de tu dispositivo o ingresa los datos manualmente para verificar su registro en SUNAT.
							</p>
						</div>
					</div>

					<a href="/guias/emitir" class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-xl bg-[#0877a7] px-4 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-[#075782] dark:bg-sky-600 dark:hover:bg-sky-500">
						<span>Guía de Consulta</span>
						<Icon name="arrow-right" size={14} />
					</a>
				</div>

				<!-- FORMULARIO PRINCIPAL DE VALIDACIÓN DE CPE -->
				<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 space-y-6">
					
					<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 pb-4 dark:border-slate-800">
						<div>
							<h3 class="text-sm font-extrabold text-slate-900 dark:text-white uppercase tracking-tight">
								Consulta la Validez del Comprobante de Pago Electrónico (CPE)
							</h3>
							<p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
								Escanea el código QR del comprobante o completa los campos manualmente.
							</p>
						</div>

						<!-- BOTONES DE ESCANEO QR Y GALERÍA DE PRUEBAS -->
						<div class="flex flex-wrap items-center gap-2">
							<button
								type="button"
								id="btn-abrir-qr-prueba"
								class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2 text-xs font-bold text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200"
							>
								<Icon name="grid" size={15} />
								<span>QR de Prueba</span>
							</button>

							<button
								type="button"
								id="btn-abrir-escaner-qr"
								class="inline-flex items-center gap-2 rounded-xl bg-[#003366] px-4 py-2 text-xs font-extrabold text-white shadow-sm transition hover:bg-[#002244] dark:bg-sky-600 dark:hover:bg-sky-500"
							>
								<Icon name="smartphone" size={16} />
								<span>Escanear comprobante o QR</span>
							</button>
						</div>
					</div>

					<form id="form-validez-cpe" class="space-y-6" novalidate>
						
						<!-- SECCIÓN 1: DATOS DEL EMISOR Y TIPO DE COMPROBANTE -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
							<div>
								<label for="val-ruc-emisor" class="block font-bold mb-1 text-slate-700 dark:text-slate-300">
									Número de RUC del Emisor <span class="text-rose-500">*</span>
								</label>
								<div class="relative">
									<input 
										type="text" 
										id="val-ruc-emisor" 
										maxlength="11" 
										placeholder="Ej: 20517352059" 
										class="h-9 w-full rounded-lg border border-slate-300 px-3 pr-12 text-xs dark:border-slate-700 dark:bg-slate-950 dark:text-white font-medium focus:border-[#0877a7] focus:ring-1 focus:ring-[#0877a7]" 
									/>
									<span id="cnt-ruc-emisor" class="absolute right-2 top-2.5 text-[10px] font-semibold text-slate-400">0/11</span>
								</div>
								<p id="err-val-ruc-emisor" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400 mt-1 hidden"></p>
							</div>

							<div>
								<label for="val-tipo-cpe" class="block font-bold mb-1 text-slate-700 dark:text-slate-300">
									Tipo de Comprobante <span class="text-rose-500">*</span>
								</label>
								<select id="val-tipo-cpe" class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs dark:border-slate-700 dark:bg-slate-950 dark:text-white font-semibold">
									<option value="FACTURA">FACTURA ELECTRÓNICA</option>
									<option value="BOLETA">BOLETA DE VENTA ELECTRÓNICA</option>
									<option value="RHE">RECIBO POR HONORARIOS ELECTRÓNICO (RHE)</option>
									<option value="NC">NOTA DE CRÉDITO ELECTRÓNICA</option>
									<option value="ND">NOTA DE DÉBITO ELECTRÓNICA</option>
									<option value="GRE">GUÍA DE REMISIÓN ELECTRÓNICA (GRE)</option>
								</select>
							</div>
						</div>

						<!-- SECCIÓN 2: DATOS DEL RECEPTOR -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
							<div>
								<label for="val-tipo-doc-rec" class="block font-bold mb-1 text-slate-700 dark:text-slate-300">
									Tipo de Doc. Identidad del Receptor
								</label>
								<select id="val-tipo-doc-rec" class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs dark:border-slate-700 dark:bg-slate-950 dark:text-white font-medium">
									<option value="0">SIN DOCUMENTO (PÚBLICO GENERAL)</option>
									<option value="6">RUC (REGISTRO ÚNICO DE CONTRIBUYENTES)</option>
									<option value="1">DNI (DOCUMENTO NACIONAL DE IDENTIDAD)</option>
									<option value="4">CARNET DE EXTRANJERÍA</option>
									<option value="7">PASAPORTE</option>
								</select>
							</div>

							<div>
								<label for="val-num-doc-rec" class="block font-bold mb-1 text-slate-700 dark:text-slate-300">
									Número Documento del Receptor
								</label>
								<div class="relative">
									<input 
										type="text" 
										id="val-num-doc-rec" 
										placeholder="Seleccione tipo de doc" 
										disabled
										class="h-9 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 pr-12 text-xs dark:border-slate-800 dark:bg-slate-950 dark:text-slate-400 font-medium" 
									/>
									<span id="cnt-doc-receptor" class="absolute right-2 top-2.5 text-[10px] font-semibold text-slate-400 hidden">0/11</span>
								</div>
								<p id="err-val-num-doc-rec" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400 mt-1 hidden"></p>
							</div>
						</div>

						<!-- SECCIÓN 3: CORRELATIVO, FECHA E IMPORTE -->
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
							<div>
								<label class="block font-bold mb-1 text-slate-700 dark:text-slate-300">
									Número del Comprobante (Serie - Número) <span class="text-rose-500">*</span>
								</label>
								<div class="flex items-center gap-1.5">
									<input 
										type="text" 
										id="val-serie" 
										maxlength="4" 
										placeholder="F001" 
										class="h-9 w-24 uppercase text-center rounded-lg border border-slate-300 px-2 text-xs font-bold dark:border-slate-700 dark:bg-slate-950 dark:text-white" 
									/>
									<span class="font-bold text-slate-400">-</span>
									<input 
										type="text" 
										id="val-numero" 
										maxlength="8" 
										placeholder="00000042" 
										class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs font-medium dark:border-slate-700 dark:bg-slate-950 dark:text-white" 
									/>
								</div>
								<p id="err-val-correlativo" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400 mt-1 hidden"></p>
							</div>

							<div>
								<label for="val-fec-emision" class="block font-bold mb-1 text-slate-700 dark:text-slate-300">
									Fecha de Emisión <span class="text-rose-500">*</span>
								</label>
								<input 
									type="date" 
									id="val-fec-emision" 
									class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs font-semibold dark:border-slate-700 dark:bg-slate-950 dark:text-white" 
								/>
								<p id="err-val-fec-emision" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400 mt-1 hidden"></p>
							</div>

							<div>
								<label for="val-monto-total" class="block font-bold mb-1 text-slate-700 dark:text-slate-300">
									Importe Total (S/) <span class="text-rose-500">*</span>
								</label>
								<input 
									type="number" 
									id="val-monto-total" 
									step="0.01" 
									placeholder="0.00" 
									class="h-9 w-full rounded-lg border border-slate-300 px-3 text-xs font-bold dark:border-slate-700 dark:bg-slate-950 dark:text-white" 
								/>
								<p id="err-val-monto-total" class="text-[11px] font-semibold text-rose-600 dark:text-rose-400 mt-1 hidden"></p>
							</div>
						</div>

						<!-- BOTONES DE ACCIÓN -->
						<div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
							<button 
								type="button" 
								id="btn-limpiar-validez" 
								class="rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-xs font-bold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300"
							>
								Limpiar Campos
							</button>

							<button 
								type="submit" 
								id="btn-buscar-validez" 
								class="inline-flex items-center gap-2 rounded-xl bg-[#0877a7] px-6 py-2.5 text-xs font-bold text-white shadow-md transition hover:bg-[#075782]"
							>
								<Icon name="search" size={16} />
								<span>Consultar Validez</span>
							</button>
						</div>
					</form>
				</div>
			</div>
		</main>
	</div>

	<!-- ========================================================================= -->
	<!-- MODAL 1: ESCÁNER DE CÓDIGO QR (CÁMARA + IMAGEN + TARJETA DETECTADA)       -->
	<!-- ========================================================================= -->
	<div id="modal-escaner-qr" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/75 p-4 backdrop-blur-sm overflow-y-auto">
		<div class="w-full max-w-lg rounded-3xl border border-slate-200 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900 space-y-4 my-6">
			
			<!-- Cabecera -->
			<div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
				<div class="flex items-center gap-2.5">
					<span class="grid h-9 w-9 place-items-center rounded-xl bg-[#003366] text-white dark:bg-sky-600">
						<Icon name="smartphone" size={18} />
					</span>
					<div>
						<h3 class="text-sm font-black text-slate-900 dark:text-white">Lector de Comprobante Electrónico (QR)</h3>
						<p class="text-[11px] text-slate-500">Enfoca el código QR o sube una imagen del comprobante</p>
					</div>
				</div>
				<button type="button" id="btn-cerrar-escaner-x" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800">
					<Icon name="x" size={18} />
				</button>
			</div>

			<!-- Pestañas: Cámara vs Imagen -->
			<div class="grid grid-cols-2 gap-2 rounded-xl bg-slate-100 p-1 dark:bg-slate-800">
				<button type="button" id="tab-qr-camara" class="rounded-lg bg-white py-2 text-xs font-extrabold text-[#003366] shadow-sm transition dark:bg-slate-900 dark:text-sky-400">
					Usar Cámara
				</button>
				<button type="button" id="tab-qr-imagen" class="rounded-lg py-2 text-xs font-bold text-slate-600 transition hover:text-slate-900 dark:text-slate-400">
					Subir Imagen QR
				</button>
			</div>

			<!-- Vista Cámara -->
			<div id="panel-qr-camara" class="space-y-3">
				<div class="relative overflow-hidden rounded-2xl border-2 border-dashed border-slate-300 bg-slate-950 min-h-[240px] flex items-center justify-center dark:border-slate-700">
					<div id="qr-reader" class="w-full"></div>
				</div>
				<p class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
					<Icon name="lock" size={13} />
					<span>Privacidad: El procesamiento ocurre localmente en tu navegador; no se graban ni envían imágenes.</span>
				</p>
			</div>

			<!-- Vista Subir Imagen -->
			<div id="panel-qr-imagen" class="hidden space-y-3">
				<label for="input-archivo-qr" class="flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 p-8 text-center cursor-pointer transition hover:border-[#0877a7] hover:bg-sky-50/40 dark:border-slate-700 dark:bg-slate-950">
					<span class="grid h-11 w-11 place-items-center rounded-2xl bg-sky-100 text-[#0877a7] dark:bg-sky-950 dark:text-sky-400">
						<Icon name="file-text" size={22} />
					</span>
					<span class="text-xs font-extrabold text-slate-800 dark:text-slate-200">Selecciona una imagen o captura con código QR</span>
					<span class="text-[11px] text-slate-500">Formatos soportados: PNG, JPG, WEBP</span>
					<input type="file" id="input-archivo-qr" accept="image/*" class="hidden" />
				</label>
				<div id="qr-file-reader" class="hidden"></div>
			</div>

			<!-- Alerta de Error / Seguridad (QR inválido, enlace malicioso, sin permiso) -->
			<div id="qr-alerta-error" class="hidden rounded-2xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-800 dark:border-rose-900 dark:bg-rose-950/60 dark:text-rose-200 space-y-2">
				<div class="flex items-start gap-2.5">
					<span class="mt-0.5 text-rose-600 dark:text-rose-400 shrink-0">
						<Icon name="alert-triangle" size={18} />
					</span>
					<div>
						<p id="qr-error-titulo" class="font-extrabold">No se pudo leer el código QR</p>
						<p id="qr-error-detalle" class="mt-0.5 text-[11px] leading-relaxed"></p>
					</div>
				</div>
				<div class="flex justify-end gap-2 pt-1">
					<button type="button" id="btn-qr-reintentar" class="rounded-lg border border-rose-300 bg-white px-3 py-1.5 text-[11px] font-bold text-rose-700 hover:bg-rose-100 dark:border-rose-800 dark:bg-slate-900 dark:text-rose-300">
						Reintentar escaneo
					</button>
					<button type="button" class="btn-qr-manual rounded-lg bg-rose-700 px-3 py-1.5 text-[11px] font-bold text-white hover:bg-rose-800">
						Ingresar manualmente
					</button>
				</div>
			</div>

			<!-- TARJETA "DATOS DETECTADOS" (Requerimiento explícito de interacción) -->
			<div id="tarjeta-datos-detectados" class="hidden rounded-2xl border border-emerald-200 bg-emerald-50/60 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/30 space-y-3">
				<div class="flex items-center justify-between border-b border-emerald-200/80 pb-2 dark:border-emerald-900/50">
					<span class="inline-flex items-center gap-1.5 text-xs font-black uppercase text-emerald-800 dark:text-emerald-300">
						<Icon name="shield-check" size={16} />
						Datos detectados del QR
					</span>
					<span id="qr-badge-modo" class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200">
						Lectura verificada
					</span>
				</div>

				<!-- Campos extraídos (editables si el usuario pulsa "Corregir") -->
				<div class="grid grid-cols-2 gap-2.5 text-xs">
					<div>
						<label class="block text-[10px] font-bold uppercase text-slate-500">RUC Emisor</label>
						<input type="text" id="det-ruc-emisor" readonly maxlength="11" class="det-input mt-0.5 h-8 w-full rounded-lg border border-slate-200 bg-white/80 px-2.5 font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
					</div>
					<div>
						<label class="block text-[10px] font-bold uppercase text-slate-500">Tipo Comprobante</label>
						<select id="det-tipo-cpe" disabled class="det-input mt-0.5 h-8 w-full rounded-lg border border-slate-200 bg-white/80 px-2 font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white">
							<option value="FACTURA">FACTURA</option>
							<option value="BOLETA">BOLETA</option>
							<option value="RHE">RHE</option>
							<option value="NC">NOTA CRÉDITO</option>
							<option value="ND">NOTA DÉBITO</option>
							<option value="GRE">GUÍA REMISIÓN</option>
						</select>
					</div>
					<div>
						<label class="block text-[10px] font-bold uppercase text-slate-500">Serie</label>
						<input type="text" id="det-serie" readonly maxlength="4" class="det-input mt-0.5 h-8 w-full rounded-lg border border-slate-200 bg-white/80 px-2.5 font-bold uppercase text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
					</div>
					<div>
						<label class="block text-[10px] font-bold uppercase text-slate-500">Número</label>
						<input type="text" id="det-numero" readonly maxlength="8" class="det-input mt-0.5 h-8 w-full rounded-lg border border-slate-200 bg-white/80 px-2.5 font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
					</div>
					<div>
						<label class="block text-[10px] font-bold uppercase text-slate-500">Fecha Emisión</label>
						<input type="date" id="det-fecha" readonly class="det-input mt-0.5 h-8 w-full rounded-lg border border-slate-200 bg-white/80 px-2.5 font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
					</div>
					<div>
						<label class="block text-[10px] font-bold uppercase text-slate-500">Importe Total (S/)</label>
						<input type="number" step="0.01" id="det-monto" readonly class="det-input mt-0.5 h-8 w-full rounded-lg border border-slate-200 bg-white/80 px-2.5 font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
					</div>
					<div class="col-span-2" id="contenedor-det-receptor">
						<label class="block text-[10px] font-bold uppercase text-slate-500">Documento Receptor (Tipo - Número)</label>
						<div class="mt-0.5 flex gap-2">
							<select id="det-tipo-doc-rec" disabled class="det-input h-8 w-28 rounded-lg border border-slate-200 bg-white/80 px-2 font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white">
								<option value="0">SIN DOC</option>
								<option value="6">RUC</option>
								<option value="1">DNI</option>
								<option value="4">CE</option>
							</select>
							<input type="text" id="det-num-doc-rec" readonly placeholder="Sin documento" class="det-input h-8 flex-1 rounded-lg border border-slate-200 bg-white/80 px-2.5 font-bold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-white" />
						</div>
					</div>
				</div>

				<p id="aviso-faltante-qr" class="hidden text-[11px] font-semibold text-amber-700 dark:text-amber-300">
					* Algunos campos opcionales no estaban codificados en el QR; puedes completarlos si lo deseas.
				</p>

				<!-- 3 DECISIONES DEL USUARIO -->
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-2 border-t border-emerald-200/80 dark:border-emerald-900/50">
					<button type="button" id="btn-qr-usar-datos" class="rounded-xl bg-[#003366] px-3 py-2 text-xs font-extrabold text-white shadow-sm hover:bg-[#002244] transition">
						Usar estos datos
					</button>
					<button type="button" id="btn-qr-corregir" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 transition">
						Corregir
					</button>
					<button type="button" class="btn-qr-manual rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 transition">
						Ingresar manualmente
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- ========================================================================= -->
	<!-- MODAL 2: GALERÍA DE QR DE PRUEBA (PARA ESCANEAR DESDE TU CELULAR)         -->
	<!-- ========================================================================= -->
	<div id="modal-qr-prueba" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/75 p-4 backdrop-blur-sm overflow-y-auto">
		<div class="w-full max-w-4xl rounded-3xl border border-slate-200 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900 space-y-5 my-6">
			<div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
				<div>
					<h3 class="text-base font-black text-slate-900 dark:text-white">Códigos QR de Prueba (Base de Datos SUNAT)</h3>
					<p class="text-xs text-slate-500">Apunta la cámara de tu celular a cualquiera de estos QR o descárgalos para probar la carga de imagen.</p>
				</div>
				<button type="button" id="btn-cerrar-qr-prueba" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800">
					<Icon name="x" size={18} />
				</button>
			</div>

			<div id="grid-qrs-generados" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
				<!-- Se llena dinámicamente con los QR de Factura, Boleta, RHE, GRE, NC y QR Malicioso -->
			</div>
		</div>
	</div>

	<!-- MODAL RESULTADO DE LA CONSULTA -->
	<div id="modal-resultado-validez" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm print:hidden">
		<div class="w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-6 shadow-2xl dark:border-slate-800 dark:bg-slate-900 space-y-5 text-slate-900 dark:text-slate-100 relative">
			
			<div class="flex items-center justify-between border-b border-slate-100 pb-3 dark:border-slate-800">
				<h3 class="text-base font-bold text-slate-900 dark:text-white">Resultado de Consulta de Validez</h3>
				<button type="button" id="btn-cerrar-modal-x" class="text-slate-400 hover:text-slate-600 font-bold">✕</button>
			</div>

			<div id="modal-alerta-box" class="flex items-start gap-3 rounded-xl border p-4 text-xs font-semibold">
				<span id="modal-badge-icon" class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-white font-black text-xs">✓</span>
				<div>
					<h4 id="modal-estado-titulo" class="font-extrabold uppercase text-xs">COMPROBANTE VÁLIDO</h4>
					<p id="modal-estado-mensaje" class="mt-0.5 text-[11px] leading-relaxed"></p>
				</div>
			</div>

			<div class="space-y-2 text-xs bg-slate-50 p-4 rounded-xl border border-slate-200 dark:bg-slate-950 dark:border-slate-800">
				<div class="flex justify-between border-b border-slate-200 pb-1.5 dark:border-slate-800">
					<span class="text-slate-500 dark:text-slate-400 font-medium">Comprobante:</span>
					<span id="res-modal-cpe" class="font-extrabold text-slate-800 dark:text-slate-200">-</span>
				</div>
				<div class="flex justify-between border-b border-slate-200 pb-1.5 dark:border-slate-800">
					<span class="text-slate-500 dark:text-slate-400 font-medium">RUC Emisor:</span>
					<span id="res-modal-emisor" class="font-bold text-slate-800 dark:text-slate-200">-</span>
				</div>
				<div class="flex justify-between border-b border-slate-200 pb-1.5 dark:border-slate-800">
					<span class="text-slate-500 dark:text-slate-400 font-medium">Fecha Emisión:</span>
					<span id="res-modal-fecha" class="font-bold text-slate-800 dark:text-slate-200">-</span>
				</div>
				<div class="flex justify-between">
					<span class="text-slate-500 dark:text-slate-400 font-medium">Importe Total:</span>
					<span id="res-modal-monto" class="font-black text-[#0877a7] dark:text-sky-400">-</span>
				</div>
			</div>

			<div class="grid grid-cols-2 gap-3 pt-2 border-t border-slate-100 dark:border-slate-800">
				<button type="button" id="btn-otra-consulta" class="flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white p-3 text-xs font-bold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 transition">
					<Icon name="search" size={16} />
