---
import Icon from '../components/Icon.astro';
import Layout from "../layouts/Layout.astro";
import type { IconName } from '../data/icons';

const indice = [
	{ id: 'importante', label: 'IMPORTANTE: Antes de presentar su Queja, Reclamo o Sugerencia' },
	{ id: 'presentar', label: 'Presentar una Queja, Reclamo o Sugerencia' },
	{ id: 'consultar', label: 'Consultar el estado de su Queja, Reclamo o Sugerencia' },
	{ id: 'derechos', label: 'Derechos de los Administrados' },
	{ id: 'marco-legal', label: 'Marco Legal' },
	{ id: 'preguntas', label: 'Preguntas Frecuentes' },
];

const tipos: { titulo: string; icon: IconName; texto: string }[] = [
	{
		titulo: 'Queja',
		icon: 'alert-triangle',
		texto: 'Cuando no estás conforme con la atención recibida: demoras, maltrato o falta de orientación del personal.',
	},
	{
		titulo: 'Reclamo',
		icon: 'message',
		texto: 'Cuando un servicio de SUNAT no funcionó como debía: el portal falló, no te entregaron un documento, etc.',
	},
	{
		titulo: 'Sugerencia',
		icon: 'star',
		texto: 'Cuando tienes una idea para mejorar la atención, los servicios en línea o los centros de servicio.',
	},
];

const derechos = [
	'Ser tratado con respeto y consideración por el personal de SUNAT.',
	'Recibir información clara, completa y gratuita sobre tus trámites.',
	'Conocer el estado de tus solicitudes y obtener copia de los documentos de tu expediente.',
	'Presentar quejas, reclamos y sugerencias sin que ello afecte tus trámites.',
	'Obtener una respuesta por escrito dentro del plazo establecido.',
	'Que tus datos personales sean protegidos y usados solo para atender tu solicitud.',
];

const marcoLegal = [
	{ norma: 'D.S. N.° 004-2019-JUS', detalle: 'Texto Único Ordenado de la Ley N.° 27444, Ley del Procedimiento Administrativo General.' },
	{ norma: 'D.S. N.° 007-2020-PCM', detalle: 'Establece disposiciones para la gestión de reclamos en las entidades de la Administración Pública.' },
	{ norma: 'D.S. N.° 133-2013-EF', detalle: 'Texto Único Ordenado del Código Tributario (la queja tributaria se rige por su artículo 155).' },
	{ norma: 'Ley N.° 29733', detalle: 'Ley de Protección de Datos Personales.' },
];

const preguntas = [
	{
		p: '¿Necesito Clave SOL para presentar una queja o sugerencia?',
		r: 'No es obligatorio, pero si ingresas desde Operaciones en Línea tus datos se completan solos y puedes ver el estado de tus solicitudes en un solo lugar.',
	},
	{
		p: '¿Cuánto tiempo tarda la respuesta?',
		r: 'SUNAT responde por escrito dentro de un plazo máximo de 30 días hábiles contados desde el registro. Te avisaremos al correo que indiques.',
	},
	{
		p: '¿Puedo presentar una queja sobre una deuda o una multa?',
		r: 'No por este medio. Si no estás de acuerdo con una deuda, multa u orden de pago, debes presentar un recurso de reclamación o una queja tributaria, que son trámites distintos.',
	},
	{
		p: '¿Qué pasa después de registrarla?',
		r: 'Recibes un número de registro (por ejemplo QS-2026-00481). Con él puedes consultar si está «Registrado», «En trámite» o «Atendido».',
	},
	{
		p: '¿Puedo adjuntar documentos?',
		r: 'Sí. Puedes adjuntar archivos PDF, JPG o PNG de hasta 10 MB cada uno como sustento. Es opcional.',
	},
];
---

<SolLayout
	title="Libro de Reclamaciones"
	description="Presenta una queja, reclamo o sugerencia a SUNAT y consulta su estado."
	current="reclamos"
>
	<div class="container-sunat py-6">
		<nav aria-label="Ruta de navegación" class="text-sm">
			<ol class="flex flex-wrap items-center gap-1.5 text-slate-500 dark:text-slate-400">
				<li><a href="/sol" class="link-sunat">Inicio</a></li>
				<li aria-hidden="true"><Icon name="chevron-right" size={14} /></li>
				<li aria-current="page" class="font-semibold text-slate-800 dark:text-slate-200">Libro de Reclamaciones</li>
			</ol>
		</nav>

		<div class="mt-4 grid gap-6 lg:grid-cols-[minmax(0,1fr)_300px]">
			<article class="min-w-0" aria-labelledby="titulo-libro">
				<header class="sol-panel">
					<p class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-sunat-blue dark:text-sky-300">
						<Icon name="book-open" size={15} />
						Atención al ciudadano
					</p>
					<h1 id="titulo-libro" class="mt-2 text-2xl font-black tracking-tight text-slate-900 dark:text-white sm:text-3xl">
						Libro de Reclamaciones
					</h1>
					<p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-300">
						Cuéntanos si algo no salió bien en tu atención o si tienes una idea para mejorar. Tu opinión nos llega
						directamente y recibirás una respuesta por escrito.
					</p>

					<div class="mt-5 grid gap-3 sm:grid-cols-2">
						<a
							href="/libro-reclamaciones/registro"
							class="group flex items-center gap-3 rounded-2xl border-2 border-sunat-blue/20 bg-sky-50 p-4 transition hover:border-sunat-blue dark:border-sky-500/30 dark:bg-sky-950/40 dark:hover:border-sky-400"
						>
							<span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-sunat-blue text-white dark:bg-sky-600">
								<Icon name="edit" size={20} />
							</span>
							<span class="min-w-0 flex-1">
								<span class="block text-sm font-bold text-slate-900 dark:text-white">Presentar una Queja, Reclamo o Sugerencia</span>
								<span class="mt-0.5 inline-flex items-center gap-1 text-sm font-bold text-sunat-blue dark:text-sky-300">
									Ingrese aquí <Icon name="arrow-right" size={15} class="transition group-hover:translate-x-0.5" />
								</span>
							</span>
						</a>
						<a
							href="/libro-reclamaciones/registro?vista=consulta"
							class="group flex items-center gap-3 rounded-2xl border-2 border-slate-200 bg-white p-4 transition hover:border-sunat-blue dark:border-slate-700 dark:bg-slate-900 dark:hover:border-sky-400"
						>
							<span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200">
								<Icon name="search" size={20} />
							</span>
							<span class="min-w-0 flex-1">
								<span class="block text-sm font-bold text-slate-900 dark:text-white">Consultar el estado de mi solicitud</span>
								<span class="mt-0.5 inline-flex items-center gap-1 text-sm font-bold text-sunat-blue dark:text-sky-300">
									Ingrese aquí <Icon name="arrow-right" size={15} class="transition group-hover:translate-x-0.5" />
								</span>
							</span>
						</a>
					</div>
				</header>

				<section id="importante" class="sol-panel mt-6 scroll-mt-28" aria-labelledby="t-importante">
					<h2 id="t-importante" class="text-lg font-bold text-slate-900 dark:text-white">Antes de presentar tu solicitud</h2>
					<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Elige el tipo que mejor describe lo que quieres contarnos.</p>
					<ul class="mt-4 grid gap-3 sm:grid-cols-3">
						{
							tipos.map((t) => (
								<li class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/60">
									<span class="grid h-9 w-9 place-items-center rounded-lg bg-sunat-red/10 text-sunat-red dark:bg-rose-500/15 dark:text-rose-300">
										<Icon name={t.icon} size={18} />
									</span>
									<h3 class="mt-2 font-bold text-slate-900 dark:text-white">{t.titulo}</h3>
									<p class="mt-1 text-sm leading-snug text-slate-600 dark:text-slate-300">{t.texto}</p>
								</li>
							))
						}
					</ul>
					<div class="mt-4 rounded-2xl bg-amber-50 p-4 text-sm text-amber-900 dark:bg-amber-500/10 dark:text-amber-200">
						<p class="flex items-center gap-2 font-bold"><Icon name="info" size={17} />Importante</p>
						<p class="mt-1">
							Este canal <strong>no</strong> sirve para impugnar deudas, multas u órdenes de pago. Para eso existe el
							recurso de reclamación o la queja tributaria.
						</p>
					</div>
				</section>

				<section id="presentar" class="sol-panel mt-6 scroll-mt-28" aria-labelledby="t-presentar">
					<h2 id="t-presentar" class="text-lg font-bold text-slate-900 dark:text-white">Presentar una Queja, Reclamo o Sugerencia</h2>
					<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Toma unos 5 minutos. Lo haces en 4 pasos:</p>
					<ol class="mt-4 grid gap-2 sm:grid-cols-4">
						{
							['Tus datos', 'Datos del titular', 'Qué pasó', 'Archivos (opcional)'].map((paso, i) => (
								<li class="flex items-center gap-2.5 rounded-xl border border-slate-200 p-3 text-sm font-semibold text-slate-800 dark:border-slate-800 dark:text-slate-200">
									<span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-sunat-blue/10 text-xs font-black text-sunat-blue dark:bg-sky-500/15 dark:text-sky-300">{i + 1}</span>
									{paso}
								</li>
							))
						}
					</ol>
					<a href="/libro-reclamaciones/registro" class="sol-btn-primary mt-4 h-11 px-5">
						Ingrese aquí <Icon name="arrow-right" size={17} />
					</a>
				</section>

				<section id="consultar" class="sol-panel mt-6 scroll-mt-28" aria-labelledby="t-consultar">
					<h2 id="t-consultar" class="text-lg font-bold text-slate-900 dark:text-white">Consultar el estado de su Queja, Reclamo o Sugerencia</h2>
					<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Con tu número de registro puedes ver en qué etapa está:</p>
					<ul class="mt-3 flex flex-wrap gap-2 text-xs font-bold uppercase">
						<li class="rounded-full bg-sky-100 px-2.5 py-1 text-sky-800 dark:bg-sky-500/15 dark:text-sky-300">Registrado</li>
						<li class="rounded-full bg-amber-100 px-2.5 py-1 text-amber-800 dark:bg-amber-500/15 dark:text-amber-300">En trámite</li>
						<li class="rounded-full bg-emerald-100 px-2.5 py-1 text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-300">Atendido</li>
					</ul>
					<a href="/libro-reclamaciones/registro?vista=consulta" class="sol-btn-secondary mt-4 h-11 px-5">
						Ver mis solicitudes <Icon name="arrow-right" size={17} />
					</a>
				</section>

				<section id="derechos" class="sol-panel mt-6 scroll-mt-28" aria-labelledby="t-derechos">
					<h2 id="t-derechos" class="text-lg font-bold text-slate-900 dark:text-white">Derechos de los Administrados</h2>
					<ul class="mt-3 grid gap-2 text-sm">
						{
							derechos.map((d) => (
								<li class="flex items-start gap-2 text-slate-700 dark:text-slate-200">
									<Icon name="check" size={16} class="mt-0.5 shrink-0 text-emerald-600 dark:text-emerald-400" />
									{d}
								</li>
							))
						}
					</ul>
				</section>

				<section id="marco-legal" class="sol-panel mt-6 scroll-mt-28" aria-labelledby="t-marco">
					<h2 id="t-marco" class="text-lg font-bold text-slate-900 dark:text-white">Marco Legal</h2>
					<dl class="mt-3 grid gap-3 text-sm">
						{
							marcoLegal.map((m) => (
								<div class="rounded-xl border border-slate-200 p-3 dark:border-slate-800">
									<dt class="font-bold text-slate-900 dark:text-white">{m.norma}</dt>
									<dd class="mt-0.5 text-slate-600 dark:text-slate-300">{m.detalle}</dd>
								</div>
							))
						}
					</dl>
				</section>

				<section id="preguntas" class="sol-panel mt-6 scroll-mt-28" aria-labelledby="t-preguntas">
					<h2 id="t-preguntas" class="text-lg font-bold text-slate-900 dark:text-white">Preguntas Frecuentes</h2>
					<div class="mt-3 grid gap-2">
						{
							preguntas.map((q) => (
								<details class="sol-categoria rounded-xl border border-slate-200 dark:border-slate-800">
									<summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-3 text-sm font-bold text-slate-900 dark:text-white">
										{q.p}
										<Icon name="chevron-down" size={17} class="sol-chevron shrink-0 text-slate-400 transition-transform" />
									</summary>
									<p class="border-t border-slate-100 px-3 py-2 text-sm text-slate-600 dark:border-slate-800 dark:text-slate-300">{q.r}</p>
								</details>
							))
						}
					</div>
				</section>
			</article>

			<aside class="grid content-start gap-4 lg:sticky lg:top-24 lg:self-start" aria-label="Índice">
				<nav class="sol-panel" aria-labelledby="t-indice">
					<h2 id="t-indice" class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Índice</h2>
					<ul class="mt-2 grid gap-0.5">
						{
							indice.map((item) => (
								<li>
									<a
										href={`#${item.id}`}
										class="block rounded-lg px-2 py-2 text-sm font-semibold text-slate-700 transition hover:bg-sky-50 hover:text-sunat-blue dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-sky-300"
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
				<section class="rounded-2xl bg-gradient-to-br from-sunat-blue to-sunat-blue-dark p-5 text-white shadow-lg dark:from-sky-900 dark:to-slate-900" aria-labelledby="t-telefono">
					<h2 id="t-telefono" class="flex items-center gap-2 font-bold"><Icon name="phone" size={18} />Atención telefónica</h2>
					<p class="mt-2 text-sm text-white/85">Lunes a viernes, de 8:30 a.m. a 6:00 p.m.</p>
					<ul class="mt-3 grid gap-1.5 text-sm">
						<li><span class="text-white/75">Fijos Lima:</span> <a href="tel:013150730" class="font-bold underline-offset-2 hover:underline">315 0730</a></li>
						<li><span class="text-white/75">Provincias:</span> <a href="tel:080112100" class="font-bold underline-offset-2 hover:underline">0801 12 100</a></li>
						<li><span class="text-white/75">Celulares:</span> <a href="tel:013150730" class="font-bold underline-offset-2 hover:underline">(01) 315 0730</a></li>
					</ul>
				</section>
			</aside>
		</div>
	</div>
</SolLayout>
